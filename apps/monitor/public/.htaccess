# SPA fallback pro React Router (BrowserRouter s base /app/).
# Bez něj F5 na /app/<route> hledá soubor na disku a vrací 404.
#
# Tvar pravidel záměrně kopíruje WordPress vzor (nejprověřenější na
# LiteSpeed sdílených hostinzích): žádný RewriteBase, negované -f/-d
# podmínky, tečkový pattern. Předchozí varianty ([OR] + průchozí
# pravidlo s pomlčkou, IfModule obálky) tu LiteSpeed tiše ignoroval.
RewriteEngine On

# Trvalý CI marker: /app/__rwcheck vrací index.html, POUZE pokud
# mod_rewrite v tomhle adresáři skutečně vyhodnocuje pravidla. Deploy
# workflow tím odliší "rewrite nefunguje" od "podmínky selhávají".
RewriteRule ^__rwcheck$ index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.html [L]
