# Apache SPA fallback configuration for Blood Kings SPA under /app/
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /app/
  
  # Serve existing physical files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirect all SPA subpath routes to /app/index.html
  RewriteRule ^.*$ /app/index.html [QSA,L]
</IfModule>

FallbackResource /app/index.html
ErrorDocument 404 /app/index.html

# Fix PHP session.gc_divisor warning
<IfModule mod_php7.c>
  php_value session.gc_divisor 100
</IfModule>
<IfModule mod_php.c>
  php_value session.gc_divisor 100
</IfModule>
