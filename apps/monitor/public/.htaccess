# LiteSpeed / Apache SPA fallback configuration for Blood Kings SPA under /app/
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /app/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /app/index.html [L]
</IfModule>

FallbackResource /app/index.html

# Fix PHP session.gc_divisor warning
<IfModule mod_php7.c>
  php_value session.gc_divisor 100
</IfModule>
<IfModule mod_php.c>
  php_value session.gc_divisor 100
</IfModule>
