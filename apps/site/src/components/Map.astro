---
// Map.astro - Live distributed agents overview from the real status API.
// No hardcoded cities/coordinates: it lists the nodes public_status returns,
// from the same shared answer as the rest of the page (lib/live-status).
// Maintenance and unknown keep their own state instead of reading "inactive".
const currentPath = Astro.url.pathname;
const isCs = currentPath.startsWith('/cs') || currentPath === '/cs';

const t = isCs ? {
  title: 'Distribuovaní agenti',
  desc: 'Živý přehled uzlů, jejichž stav hlásí veřejné status API.',
  loading: 'Načítám živá data...',
  unavailable: 'Data o agentech jsou momentálně nedostupná.',
  empty: 'Zatím nejsou nasazeni žádní distribuovaní agenti - viz BKPepe/monitoring-agent.',
  online: 'Online',
  warning: 'Zpožděno',
  offline: 'Mimo provoz',
  maintenance: 'Údržba',
  unknown: 'Neznámý stav',
  nodesLabel: 'uzlů',
} : {
  title: 'Distributed Agents',
  desc: 'Live view of the nodes the public status API reports.',
  loading: 'Loading live data...',
  unavailable: 'Agent data is temporarily unavailable.',
  empty: 'No distributed agents deployed yet - see BKPepe/monitoring-agent.',
  online: 'Online',
  warning: 'Delayed',
  offline: 'Down',
  maintenance: 'Maintenance',
  unknown: 'Unknown',
  nodesLabel: 'nodes',
};
---

<div class="map-card card" id="agent-map-card">
  <div class="map-header">
    <div class="map-title-info">
      <h4>{t.title}</h4>
      <p>{t.desc}</p>
    </div>
    <div class="map-stats-badges">
      <span class="badge badge-success" id="agent-map-count">— {t.nodesLabel}</span>
    </div>
  </div>

  <div class="agent-nodes-grid" id="agent-nodes-grid" aria-live="polite" data-unavailable={t.unavailable} data-empty={t.empty} data-online={t.online} data-warning={t.warning} data-offline={t.offline} data-maintenance={t.maintenance} data-unknown={t.unknown} data-nodes-label={t.nodesLabel}>
    <p class="agent-nodes-status">{t.loading}</p>
  </div>
</div>

<script>
  import { escapeHtml } from '../lib/github';
  import { onLiveStatus, type NodeState } from '../lib/live-status';

  const grid = document.getElementById('agent-nodes-grid');
  const countBadge = document.getElementById('agent-map-count');
  const words: DOMStringMap = grid?.dataset ?? {};
  const STATE_WORD: Record<NodeState, string | undefined> = {
    online: words.online,
    warning: words.warning,
    offline: words.offline,
    maintenance: words.maintenance,
    unknown: words.unknown,
  };

  onLiveStatus((result) => {
    if (!grid) return;

    if (!result.ok) {
      grid.innerHTML = `<p class="agent-nodes-status">${escapeHtml(words.unavailable)}</p>`;
      if (countBadge) countBadge.textContent = `— ${words.nodesLabel ?? ''}`;
      return;
    }

    const nodes = result.data.nodes;
    if (countBadge) countBadge.textContent = `${nodes.length} ${words.nodesLabel ?? ''}`;

    if (nodes.length === 0) {
      grid.innerHTML = `<p class="agent-nodes-status">${escapeHtml(words.empty)}</p>`;
      return;
    }

    grid.innerHTML = nodes
      .map((n) => {
        const meta = [STATE_WORD[n.status] ?? '', n.latencyMs !== null ? `${n.latencyMs} ms` : '']
          .filter(Boolean)
          .join(' · ');
        return `
          <div class="agent-node-item node-${n.status}">
            <span class="node-dot"></span>
            <div class="node-info">
              <span class="node-name">${escapeHtml(n.name)}</span>
              <span class="node-meta">${escapeHtml(meta)}</span>
            </div>
          </div>`;
      })
      .join('');
  });
</script>

<style>
  .map-card {
    background: var(--surface-1);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2.5rem;
  }

  .map-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.2rem;
  }

  .map-title-info h4 {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .map-title-info p {
    font-size: 0.9rem;
    margin-top: 0.2rem;
    color: var(--text-low);
  }

  .map-stats-badges {
    display: flex;
    gap: 0.75rem;
  }

  .agent-nodes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
    min-height: 4rem;
  }

  /* Grid contents are written by the script (innerHTML) and carry no scoped
     attribute, so the rules reach them through :global() under the grid. */
  .agent-nodes-grid :global(.agent-nodes-status) {
    color: var(--text-low);
    font-size: 0.9rem;
    grid-column: 1 / -1;
    padding: 1rem 0;
  }

  .agent-nodes-grid :global(.agent-node-item) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
  }

  .agent-nodes-grid :global(.node-dot) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .agent-nodes-grid :global(.node-online .node-dot) { background: var(--up); box-shadow: 0 0 0 3px var(--up-bg); }
  .agent-nodes-grid :global(.node-warning .node-dot) { background: var(--warning); box-shadow: 0 0 0 3px var(--warning-bg); }
  .agent-nodes-grid :global(.node-offline .node-dot) { background: var(--down); box-shadow: 0 0 0 3px var(--down-bg); }
  .agent-nodes-grid :global(.node-maintenance .node-dot) { background: var(--info); box-shadow: 0 0 0 3px var(--info-bg); }
  /* Unknown is not an outage: a hollow grey ring, not red. */
  .agent-nodes-grid :global(.node-unknown .node-dot) { border: 1.5px dashed var(--text-low); }

  .agent-nodes-grid :global(.node-info) {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .agent-nodes-grid :global(.node-name) {
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .agent-nodes-grid :global(.node-meta) {
    font-size: 0.75rem;
    color: var(--text-low);
  }

  @media (max-width: 768px) {
    .map-card {
      padding: 1.5rem;
    }
    .map-header {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
