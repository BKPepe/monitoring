---
// ThemeScript.astro - Prevents theme-flicker on load. The script itself is
// lib/theme-script.js, whose sha256 astro.config.mjs puts into the CSP.
// data-cfasync="false" keeps Cloudflare Rocket Loader from deferring it: it
// has to run in <head>, before the first paint, or the page flashes light.
import { THEME_SCRIPT } from '../lib/theme-script.js';
---
<script is:inline data-cfasync="false" set:html={THEME_SCRIPT} />
