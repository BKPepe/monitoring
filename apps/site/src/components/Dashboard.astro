---
// Dashboard.astro - the live panel in the hero, from the real status API.
//
// Every number here comes from the shared /api/status answer
// (lib/live-status). Until it loads, and whenever it fails, every value is a
// dash; a failed refresh blanks the previous answer instead of leaving it on
// screen as if current. The verdict line follows the server's own verdict
// (bk_overall_verdict behind public_status) and is never upgraded here:
// "All systems operational" needs a healthy verdict over fresh data.
//
// The release is the server's latest GitHub release or tag from the worker's
// /api/versions; when there is none the panel says so with a dash.
import { dicts, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dicts[lang].home.panel;
const locale = dicts[lang].locale;
const stats = [
  { id: 'lp-monitors', label: t.monitors },
  { id: 'lp-agents', label: t.agents },
  { id: 'lp-latency', label: t.latency },
  { id: 'lp-uptime', label: t.uptime },
];
---

<section
  class="live-panel"
  id="live-panel"
  aria-labelledby="live-panel-title"
  data-locale={locale}
  data-loading={t.loading}
  data-live={t.live}
  data-stale={t.stale}
  data-unavailable={t.unavailable}
  data-healthy={t.healthy}
  data-degraded={t.degraded}
  data-down={t.down}
  data-maintenance={t.maintenance}
  data-unknown={t.unknown}
  data-stale-line={t.staleLine}
  data-load-error={t.loadError}
>
  <header class="lp-head">
    <div>
      <h2 class="lp-title" id="live-panel-title">{t.title}</h2>
      <p class="lp-sub">{t.subtitle}</p>
    </div>
    <span class="lp-state" id="lp-state" data-state="loading">
      <span class="lp-dot" aria-hidden="true"></span>
      <span id="lp-state-word">{t.loading}</span>
    </span>
  </header>

  <p class="lp-verdict" id="lp-verdict" data-tone="none" aria-live="polite">{t.waiting}</p>

  <dl class="lp-stats">
    {
      stats.map((s) => (
        <div class="lp-stat">
          <dt>{s.label}</dt>
          <dd class="tabular" id={s.id}>
            —
          </dd>
        </div>
      ))
    }
  </dl>

  <dl class="lp-meta">
    <div>
      <dt>{t.updated}</dt>
      <dd class="tabular" id="lp-updated">—</dd>
    </div>
    <div>
      <dt>{t.release}</dt>
      <dd class="tabular" id="lp-release">—</dd>
    </div>
  </dl>

  <p class="lp-source">{t.source}</p>
</section>

<script>
  import { API_ORIGIN } from '../config';
  import { onLiveStatus, type Verdict } from '../lib/live-status';

  const panel = document.getElementById('live-panel');
  const words: DOMStringMap = panel?.dataset ?? {};
  const locale = words.locale ?? 'en-GB';
  const byId = (id: string) => document.getElementById(id);
  const set = (id: string, text: string) => {
    const el = byId(id);
    if (el) el.textContent = text;
  };
  const num = (value: number | null, digits = 0) =>
    value === null ? '—' : new Intl.NumberFormat(locale, { maximumFractionDigits: digits, minimumFractionDigits: digits }).format(value);

  function setState(state: 'loading' | 'live' | 'stale' | 'unavailable') {
    const badge = byId('lp-state');
    if (badge) badge.dataset.state = state;
    set('lp-state-word', words[state] ?? '');
  }

  function setVerdict(text: string, tone: 'ok' | 'warn' | 'bad' | 'info' | 'none') {
    const line = byId('lp-verdict');
    if (!line) return;
    line.textContent = text;
    line.dataset.tone = tone;
  }

  function when(date: Date | null): string {
    if (!date) return '—';
    const today = new Date().toDateString() === date.toDateString();
    return new Intl.DateTimeFormat(locale, today ? { timeStyle: 'short' } : { dateStyle: 'medium', timeStyle: 'short' }).format(date);
  }

  const TONE: Record<Verdict, 'ok' | 'warn' | 'bad' | 'info' | 'none'> = {
    healthy: 'ok',
    degraded: 'warn',
    down: 'bad',
    maintenance: 'info',
    unknown: 'none',
  };

  onLiveStatus((result) => {
    if (!result.ok) {
      setState('unavailable');
      setVerdict(words.loadError ?? '', 'none');
      for (const id of ['lp-monitors', 'lp-agents', 'lp-latency', 'lp-uptime', 'lp-updated']) set(id, '—');
      return;
    }
    const d = result.data;
    setState(d.fresh ? 'live' : 'stale');
    if (d.fresh) setVerdict(words[d.verdict] ?? '', TONE[d.verdict]);
    else setVerdict(words.staleLine ?? '', 'none');

    set('lp-monitors', num(d.totalMonitors));
    set('lp-agents', d.agentsTotal === null ? '—' : `${num(d.agentsOnline)} / ${num(d.agentsTotal)}`);
    set('lp-latency', d.avgLatencyMs === null ? '—' : `${num(d.avgLatencyMs)} ms`);
    set('lp-uptime', d.uptimePercent === null ? '—' : `${num(d.uptimePercent, 2)} %`);
    set('lp-updated', when(d.lastUpdated));
  });

  // The server release: a tag-shaped string or a dash, never a typed-in version.
  fetch(`${API_ORIGIN}/api/versions`)
    .then((r) => (r.ok ? r.json() : null))
    .then((v: { monitoring?: unknown } | null) => {
      const tag = v?.monitoring;
      set('lp-release', typeof tag === 'string' && /^v?\d[\w.-]*$/.test(tag) ? tag : '—');
    })
    .catch(() => set('lp-release', '—'));
</script>

<style>
  .live-panel {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    background: color-mix(in oklab, var(--surface-1) 92%, transparent);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .lp-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .lp-title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .lp-sub {
    margin-top: 0.2rem;
    font-size: var(--text-xs);
    color: var(--text-low);
  }

  .lp-state {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-strong);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-mid);
    white-space: nowrap;
  }

  .lp-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-low);
  }

  .lp-state[data-state='live'] {
    color: var(--up);
    border-color: color-mix(in oklab, var(--up) 35%, transparent);
  }

  /* The pulse means "live data, just now"; stale or failed answers get none. */
  .lp-state[data-state='live'] .lp-dot {
    background: var(--up);
    animation: ping 2s var(--ease) infinite;
  }

  .lp-state[data-state='stale'] {
    color: var(--warning);
  }

  .lp-state[data-state='stale'] .lp-dot {
    background: var(--warning);
  }

  .lp-state[data-state='unavailable'] .lp-dot {
    background: transparent;
    border: 1.5px solid var(--text-low);
  }

  .lp-verdict {
    min-height: 3em;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-md);
    background: var(--surface-2);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--text-mid);
  }

  .lp-verdict[data-tone='ok'] {
    color: var(--up);
    font-weight: 600;
  }
  .lp-verdict[data-tone='warn'] {
    color: var(--warning);
    font-weight: 600;
  }
  .lp-verdict[data-tone='bad'] {
    color: var(--down);
    font-weight: 600;
  }
  .lp-verdict[data-tone='info'] {
    color: var(--info);
    font-weight: 600;
  }

  .lp-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .lp-stat {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 1rem;
    background: var(--surface-1);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-low);
  }

  .lp-stat dd {
    font-family: var(--font-mono);
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--text-hi);
    min-width: 7ch;
  }

  .lp-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
  }

  .lp-meta div {
    display: grid;
    gap: 0.25rem;
  }

  .lp-meta dd {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-hi);
  }

  .lp-source {
    padding-top: 1rem;
    border-top: 1px dashed var(--border-strong);
    font-size: var(--text-xs);
    color: var(--text-low);
  }
</style>
