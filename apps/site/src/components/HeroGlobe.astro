---
/**
 * HeroGlobe.astro — hlavní vizuál hero sekce.
 *
 * Globus s uzly agentů a oblouky spojení. Čisté inline SVG, nulový
 * third-party request. Pevný aspect-ratio drží CLS na nule.
 *
 * The globe is a decorative illustration. The numbers in the pills are not:
 * they read the live `/api/status` through the shared lib/live-status, the
 * same answer the dashboard preview renders (they used to be a hard-coded
 * 12 and 9). Until it loads, and on failure, they show a dash.
 */

interface Props {
  labels: {
    agents: string;
    monitors: string;
    /** Textová alternativa vizuálu pro čtečky. */
    visualDescription: string;
  };
}

const { labels } = Astro.props;

const currentPath = Astro.url.pathname;
const isCs = currentPath.startsWith('/cs') || currentPath === '/cs';

// State words of the pills. The monitors pill takes the server's verdict
// (bk_overall_verdict) as it is; the site never upgrades it.
const states = isCs
  ? {
      loading: 'Načítám…',
      unavailable: 'Nedostupné',
      stale: 'Stará data',
      online: 'Online',
      partial: 'online',
      healthy: 'V pořádku',
      degraded: 'Zhoršené',
      down: 'mimo provoz',
      maintenance: 'Údržba',
      unknown: 'Neznámý stav',
    }
  : {
      loading: 'Loading…',
      unavailable: 'Unavailable',
      stale: 'Stale data',
      online: 'Online',
      partial: 'online',
      healthy: 'All up',
      degraded: 'Degraded',
      down: 'down',
      maintenance: 'Maintenance',
      unknown: 'Unknown',
    };

// Body agentů na projekci globusu (viewBox 0 0 600 600).
// `d` je delay animace, aby pulzy neběžely synchronně.
const nodes = [
  { x: 232, y: 196, d: 0 },
  { x: 300, y: 158, d: 0.6 },
  { x: 372, y: 212, d: 1.2 },
  { x: 196, y: 296, d: 1.8 },
  { x: 404, y: 318, d: 0.3 },
  { x: 262, y: 372, d: 0.9 },
  { x: 348, y: 404, d: 1.5 },
  { x: 300, y: 268, d: 2.1 },
];

// Oblouky mezi uzly — kvadratická křivka s kontrolním bodem vytaženým ven,
// aby spoje vypadaly jako trasy nad povrchem, ne jako tětivy.
const arcs = [
  [0, 1],
  [1, 2],
  [0, 3],
  [2, 4],
  [3, 5],
  [4, 6],
  [5, 6],
  [7, 1],
  [7, 4],
  [7, 3],
];

const arcPaths = arcs.map(([a, b], i) => {
  const n1 = nodes[a];
  const n2 = nodes[b];
  const mx = (n1.x + n2.x) / 2;
  const my = (n1.y + n2.y) / 2;
  // Vytažení kontrolního bodu směrem od středu globusu (300,300).
  const cx = mx + (mx - 300) * 0.28;
  const cy = my + (my - 300) * 0.28;
  return { d: `M${n1.x} ${n1.y} Q${cx} ${cy} ${n2.x} ${n2.y}`, delay: i * 0.45 };
});

// Poledníky a rovnoběžky mřížky globusu.
const meridians = [0.35, 0.7, 1].map((k) => k * 200);
const parallels = [-120, -60, 0, 60, 120];
---

<div class="globe-wrap">
  <svg
    class="globe"
    viewBox="0 0 600 600"
    role="img"
    aria-label={labels.visualDescription}
  >
    <defs>
      <radialGradient id="globe-fill" cx="38%" cy="32%" r="72%">
        <stop offset="0%" stop-color="var(--surface-2)" />
        <stop offset="100%" stop-color="var(--surface-0)" />
      </radialGradient>
      <radialGradient id="globe-halo" cx="50%" cy="50%" r="50%">
        <stop offset="60%" stop-color="var(--brand-500)" stop-opacity="0" />
        <stop offset="100%" stop-color="var(--brand-500)" stop-opacity="0.18" />
      </radialGradient>
    </defs>

    <circle cx="300" cy="300" r="252" fill="url(#globe-halo)" />
    <circle cx="300" cy="300" r="205" fill="url(#globe-fill)" stroke="var(--border-strong)" stroke-width="1" />

    <g class="grid" aria-hidden="true">
      {meridians.map((rx) => (
        <ellipse cx="300" cy="300" rx={rx} ry="205" />
      ))}
      {parallels.map((dy) => (
        <ellipse cx="300" cy={300 + dy} rx={Math.sqrt(Math.max(0, 205 * 205 - dy * dy))} ry="26" />
      ))}
    </g>

    <g class="arcs" aria-hidden="true">
      {arcPaths.map((_, i) => (
        <path d={arcPaths[i].d} data-arc={i} />
      ))}
    </g>

    <g class="nodes" aria-hidden="true">
      {nodes.map((n, i) => (
        <g data-node={i}>
          <circle class="node-halo" cx={n.x} cy={n.y} r="10" />
          <circle class="node-core" cx={n.x} cy={n.y} r="3.5" />
        </g>
      ))}
    </g>
  </svg>

  <!-- Live numbers from /api/status; a dash until they load. -->
  <div
    class="globe-stats"
    aria-live="polite"
    data-state-loading={states.loading}
    data-state-unavailable={states.unavailable}
    data-state-stale={states.stale}
    data-state-online={states.online}
    data-state-partial={states.partial}
    data-state-healthy={states.healthy}
    data-state-degraded={states.degraded}
    data-state-down={states.down}
    data-state-maintenance={states.maintenance}
    data-state-unknown={states.unknown}
  >
    <div class="globe-stat">
      <span class="globe-stat-value tabular" data-live="agents-value">—</span>
      <span class="globe-stat-label">{labels.agents}</span>
      <span class="globe-stat-state neutral" data-live="agents-state"><span class="status-dot"></span><span data-live="agents-text">{states.loading}</span></span>
    </div>
    <div class="globe-stat-divider" aria-hidden="true"></div>
    <div class="globe-stat">
      <span class="globe-stat-value tabular" data-live="monitors-value">—</span>
      <span class="globe-stat-label">{labels.monitors}</span>
      <span class="globe-stat-state neutral" data-live="monitors-state"><span class="status-dot"></span><span data-live="monitors-text">{states.loading}</span></span>
    </div>
  </div>
</div>

<script>
  import { dash, onLiveStatus, type Verdict } from '../lib/live-status';

  const box = document.querySelector<HTMLElement>('.globe-stats');
  const el = (name: string) => box?.querySelector<HTMLElement>(`[data-live="${name}"]`) ?? null;
  const word = (key: string) => box?.dataset[`state${key[0].toUpperCase()}${key.slice(1)}`] ?? '';

  type Tone = 'up' | 'warning' | 'down' | 'info' | 'neutral';
  const VERDICT_TONE: Record<Verdict, Tone> = {
    healthy: 'up',
    degraded: 'warning',
    down: 'down',
    maintenance: 'info',
    unknown: 'neutral',
  };

  function setState(prefix: string, text: string, tone: Tone, live = false) {
    const state = el(`${prefix}-state`);
    const label = el(`${prefix}-text`);
    if (label) label.textContent = text;
    if (!state) return;
    state.className = `globe-stat-state ${tone}`;
    // The pulsing dot means "live and fine"; it is earned, not decoration.
    state.querySelector('.status-dot')?.classList.toggle('status-dot-live', live);
  }

  onLiveStatus((result) => {
    const agents = el('agents-value');
    const monitors = el('monitors-value');

    if (!result.ok) {
      if (agents) agents.textContent = '—';
      if (monitors) monitors.textContent = '—';
      setState('agents', word('unavailable'), 'neutral');
      setState('monitors', word('unavailable'), 'neutral');
      return;
    }

    const d = result.data;
    if (agents) agents.textContent = dash(d.agentsOnline);
    if (monitors) monitors.textContent = dash(d.totalMonitors);

    if (!d.fresh) {
      setState('agents', word('stale'), 'neutral');
    } else if (d.agentsTotal && d.agentsOnline === d.agentsTotal) {
      // Every agent online is true on its own, but the pulse says "all fine"
      // and needs the overall verdict to agree.
      setState('agents', word('online'), 'up', d.verdict === 'healthy');
    } else if (d.agentsTotal && d.agentsOnline !== null) {
      setState('agents', `${d.agentsOnline} / ${d.agentsTotal} ${word('partial')}`, 'warning');
    } else {
      setState('agents', word('unknown'), 'neutral');
    }

    const verdictText =
      d.verdict === 'down' && d.downMonitors ? `${d.downMonitors} ${word('down')}` : word(d.verdict);
    setState('monitors', d.fresh ? verdictText : word('stale'), d.fresh ? VERDICT_TONE[d.verdict] : 'neutral');
  });
</script>

<style>
  .globe-wrap {
    position: relative;
    width: 100%;
    /* Pevný poměr stran — vizuál nikdy neposune obsah pod sebou (CLS 0). */
    aspect-ratio: 1;
    max-width: 560px;
    margin-inline: auto;
  }

  .globe {
    width: 100%;
    height: 100%;
  }

  .grid ellipse {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
  }

  .arcs path {
    fill: none;
    stroke: var(--brand-500);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 4 260;
    opacity: 0.85;
    animation: arc-travel 4.5s var(--ease) infinite;
  }

  /* Rozfázování běží přes atributové selektory, ne přes style="" atribut —
     ten by strict CSP (style-src bez 'unsafe-inline') zablokovala. */
  .arcs path[data-arc='1'] { animation-delay: 0.45s; }
  .arcs path[data-arc='2'] { animation-delay: 0.9s; }
  .arcs path[data-arc='3'] { animation-delay: 1.35s; }
  .arcs path[data-arc='4'] { animation-delay: 1.8s; }
  .arcs path[data-arc='5'] { animation-delay: 2.25s; }
  .arcs path[data-arc='6'] { animation-delay: 2.7s; }
  .arcs path[data-arc='7'] { animation-delay: 3.15s; }
  .arcs path[data-arc='8'] { animation-delay: 3.6s; }
  .arcs path[data-arc='9'] { animation-delay: 4.05s; }

  .node-core {
    fill: var(--brand-400);
  }

  .node-halo {
    fill: var(--brand-500);
    opacity: 0.25;
    transform-box: fill-box;
    transform-origin: center;
    animation: node-pulse 3s var(--ease) infinite;
  }

  .nodes g[data-node='1'] .node-halo { animation-delay: 0.6s; }
  .nodes g[data-node='2'] .node-halo { animation-delay: 1.2s; }
  .nodes g[data-node='3'] .node-halo { animation-delay: 1.8s; }
  .nodes g[data-node='4'] .node-halo { animation-delay: 0.3s; }
  .nodes g[data-node='5'] .node-halo { animation-delay: 0.9s; }
  .nodes g[data-node='6'] .node-halo { animation-delay: 1.5s; }
  .nodes g[data-node='7'] .node-halo { animation-delay: 2.1s; }

  @keyframes arc-travel {
    from { stroke-dashoffset: 264; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes node-pulse {
    0%, 100% { scale: 0.7; opacity: 0.15; }
    50% { scale: 1.15; opacity: 0.4; }
  }

  /* Statický stav pro uživatele, kteří si vyžádali omezený pohyb. */
  @media (prefers-reduced-motion: reduce) {
    .arcs path {
      animation: none;
      stroke-dasharray: none;
      opacity: 0.5;
    }
    .node-halo {
      animation: none;
      opacity: 0.3;
    }
  }

  /* --- Stat pilulky ---------------------------------------------------- */
  .globe-stats {
    position: absolute;
    right: 0;
    bottom: 4%;
    display: flex;
    align-items: stretch;
    gap: 1.25rem;
    padding: 1rem 1.35rem;
    background: color-mix(in oklab, var(--surface-1) 88%, transparent);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
  }

  .globe-stat {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-areas: 'value label' 'value state';
    align-items: center;
    column-gap: 0.6rem;
  }

  .globe-stat-value {
    grid-area: value;
    font-family: var(--font-heading);
    font-size: 1.9rem;
    font-weight: 800;
    line-height: 1;
    color: var(--text-hi);
  }

  .globe-stat-label {
    grid-area: label;
    font-size: var(--text-xs);
    color: var(--text-low);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .globe-stat-state {
    grid-area: state;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .globe-stat-state.up {
    color: var(--up);
  }

  .globe-stat-state.warning {
    color: var(--warning);
  }

  .globe-stat-state.down {
    color: var(--down);
  }

  .globe-stat-state.info {
    color: var(--info);
  }

  .globe-stat-state.neutral {
    color: var(--text-low);
  }

  .globe-stat-divider {
    width: 1px;
    background: var(--border);
  }

  @media (max-width: 560px) {
    .globe-stats {
      position: static;
      margin-top: -2rem;
      justify-content: center;
    }
  }
</style>
