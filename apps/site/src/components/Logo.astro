---
// The Blood Kings mark: three rising signal bars with crown points on one
// base. The same drawing as public/favicon.svg, inline so it follows the
// theme's brand colour and needs no request.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg class="logo-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="8" fill="var(--brand-600)"></rect>
  <path
    fill="#fff"
    d="M7 23v-4l2.5-3.5L12 19v4zm6.5 0v-9l2.5-3.5 2.5 3.5v9zm6.5 0V9.5L22.5 6 25 9.5V23zM7 24.25h18v2.25H7z"
  ></path>
</svg>
