---
// AgentSelector.astro - agent install tabs.
//
// The install steps are the app's own (apps/monitor/src/lib/agent-install.ts,
// through lib/agent-install.ts): the same commands and texts the app's "Add
// New Monitor" dialog prints, here with https://YOUR-DOMAIN and
// YOUR_AGENT_KEY in place of the reader's address and key. A hand-written
// copy stood here and drifted: it downloaded from and registered against the
// author's own server. The uninstall steps undo exactly what the install
// steps did.
//
// variant="full" (download page) adds registration with a token and the
// troubleshooting checks; "compact" (home page) links to them instead.
//
// Versions come from the worker's /api/agents, which reads the published
// scripts; until it answers, and when it fails, the badge shows a dash.
import { AGENTS_SOURCE_URL } from '../config';
import type { Lang } from '../i18n';
import {
  AGENT_OFFLINE_DEFAULT_MINUTES,
  APP_LABELS,
  registerCommand,
  siteInstallSteps,
  type AgentPlatform,
} from '../lib/agent-install';

interface Props {
  lang: Lang;
  variant?: 'full' | 'compact';
}
const { lang, variant = 'full' } = Astro.props;
const cs = lang === 'cs';
const prefix = cs ? '/cs' : '';
const app = (key: keyof typeof APP_LABELS) => APP_LABELS[key][lang];

const t = cs
  ? {
      tabs: 'Platforma agenta',
      version: 'Verze',
      needs: 'Potřebuje',
      readFirst: 'Nejdřív si přečtěte skript',
      install: 'Instalace',
      uninstall: 'Odinstalace',
      uninstallNote: 'Pak v přehledu smažte monitor agenta, aby jeho klíč přestal platit.',
      copy: 'Kopírovat',
      copied: 'Zkopírováno do schránky',
      copyFailed: 'Kopírování se nepodařilo, označte text ručně',
      inApp: `Nejsnáz z vlastní aplikace: ${app('nav.infrastructure')} → ${app('infra.add_agent')} → ${app('infra.type_openwrt')} nebo ${app('infra.type_vps')} a uložit. Dialog pak vypíše tytéž kroky s vaší adresou a klíčem monitoru. Níže je zastupují https://YOUR-DOMAIN a YOUR_AGENT_KEY.`,
      linux: 'Bash agent. Adresu serveru a svůj klíč čte z agent.cfg vedle skriptu a hlásí přes HTTPS; cron ho spouští každých 5 minut.',
      linuxNeeds: 'Bash, cron a wget; curl pro registraci tokenem. Práva roota pro /opt.',
      openwrt: 'Skript v POSIX sh pro OpenWrt a Turris OS, bez bashe a Pythonu. Adresu serveru a svůj klíč čte z agent_openwrt.cfg vedle skriptu; cron ho spouští každou minutu a skript po běhu skončí.',
      openwrtNeeds: 'OpenWrt nebo Turris OS s cronem a ubus; curl, uclient-fetch nebo wget. Volitelně iw (vytížení kanálu) a smartmontools (SMART).',
      windows: 'PowerShell agent. Nemá registrační příkaz: klíč agenta z přehledu uložte do agent.cfg a Plánovač úloh ho spouští každých 5 minut.',
      windowsNeeds: 'Windows PowerShell 5.1 nebo novější, spuštěný jako správce.',
      docker: 'Python agent v kontejneru python:3-alpine. Doplňte klíč agenta z přehledu.',
      dockerNeeds: 'Docker s pluginem compose. Kontejner používá pid: host a network_mode: host a připojí / jen pro čtení, takže hlásí hostitele, ne sebe.',
      raspberry: 'Stejný Bash agent jako na Linuxu.',
      raspberryNeeds: 'Raspberry Pi OS (ARMv7 nebo ARM64) s cronem a wget; curl pro registraci tokenem.',
      registerTitle: 'Víc strojů: registrace tokenem',
      registerText: 'Agent pro Bash a pro OpenWrt si umí monitor založit sám. Stáhněte skript (první krok na jeho kartě) a místo zápisu konfigurace spusťte řádek níže: server odpoví novým klíčem a agent ho uloží do agent.cfg (na routeru agent_openwrt.cfg) vedle skriptu. Pak pokračujte ručním spuštěním a cronem. Oba argumenty jsou poziční; bez adresy se agent registruje proti výchozímu localhost.',
      registerToken: `Token je v aplikaci v ${app('nav.settings')} → ${app('settings.agent_token_label')}. Dokud je prázdný, server místo něj přijme klíč cronu (CRON_KEY), takže kdo má klíč cronu, může přidávat monitory. Agenti pro Python, PowerShell a Docker registrační příkaz nemají.`,
      registerShell: 'Bash (Linux, Raspberry Pi)',
      registerOpenwrt: 'OpenWrt / Turris',
      troubleTitle: 'Agent se v aplikaci neukáže',
      troubleText: 'Pro každou platformu tři kontroly v tomto pořadí: je agent naplánovaný, co vypíše jeden ruční běh a co je na konci jeho logu.',
      troubleLinux: 'Linux / Raspberry Pi',
      troubleOpenwrt: 'OpenWrt / Turris',
      troubleWindows: 'Windows (PowerShell jako správce)',
      troubleDocker: 'Docker (výpis kontejneru)',
      troubleSilent: `Server označí monitor agenta za nedostupný po ${AGENT_OFFLINE_DEFAULT_MINUTES} minutách bez hlášení. Limit je v ${app('nav.settings')} → ${app('settings.agent_offline_timeout_label')}; 0 kontrolu vypne.`,
      compactMore: 'Registrace více strojů jedním tokenem a co zkontrolovat, když se agent neukáže:',
      compactLink: 'na stránce ke stažení',
    }
  : {
      tabs: 'Agent platform',
      version: 'Version',
      needs: 'Needs',
      readFirst: 'Read the script first',
      install: 'Install',
      uninstall: 'Uninstall',
      uninstallNote: 'Then delete the agent’s monitor in the dashboard so its key stops working.',
      copy: 'Copy',
      copied: 'Copied to the clipboard',
      copyFailed: 'Copying failed; select the text by hand',
      inApp: `Easiest from your own app: ${app('nav.infrastructure')} → ${app('infra.add_agent')} → ${app('infra.type_openwrt')} or ${app('infra.type_vps')}, then save. The dialog prints these steps with your address and the monitor’s key filled in. Below, https://YOUR-DOMAIN and YOUR_AGENT_KEY stand in for them.`,
      linux: 'A Bash agent. It reads the server address and its key from agent.cfg next to the script and reports over HTTPS; cron runs it every 5 minutes.',
      linuxNeeds: 'Bash, cron and wget; curl for registration with a token. Root for /opt.',
      openwrt: 'A POSIX sh script for OpenWrt and Turris OS, no bash or Python. It reads the server address and its key from agent_openwrt.cfg next to the script; cron starts it every minute and it exits after each run.',
      openwrtNeeds: 'OpenWrt or Turris OS with cron and ubus; curl, uclient-fetch or wget. Optional: iw (channel load) and smartmontools (SMART).',
      windows: 'A PowerShell agent. It has no register command: put the agent key from the dashboard into agent.cfg, and the Task Scheduler runs it every 5 minutes.',
      windowsNeeds: 'Windows PowerShell 5.1 or newer, run as administrator.',
      docker: 'The Python agent in a python:3-alpine container. Fill in the agent key from the dashboard.',
      dockerNeeds: 'Docker with the compose plugin. The container uses pid: host and network_mode: host and mounts / read-only, so it reports the host, not itself.',
      raspberry: 'The same Bash agent as on Linux.',
      raspberryNeeds: 'Raspberry Pi OS (ARMv7 or ARM64) with cron and wget; curl for registration with a token.',
      registerTitle: 'Many machines: register with a token',
      registerText: 'The Bash and OpenWrt agents can create their own monitor. Download the script (the first step on its tab), then run the line below instead of writing the config: the server answers with a new key, and the agent stores it in agent.cfg (agent_openwrt.cfg on a router) next to the script. Then continue with the test run and cron. Both arguments are positional; without the address the agent registers against its localhost default.',
      registerToken: `The token is in your app under ${app('nav.settings')} → ${app('settings.agent_token_label')}. While it is empty, the server accepts the cron key (CRON_KEY) in its place, so whoever has the cron key can add monitors. The Python, PowerShell and Docker agents have no register command.`,
      registerShell: 'Bash (Linux, Raspberry Pi)',
      registerOpenwrt: 'OpenWrt / Turris',
      troubleTitle: 'The agent does not show up in the app',
      troubleText: 'Three checks per platform, in this order: is the agent scheduled, what does one run by hand print, and what is at the end of its log.',
      troubleLinux: 'Linux / Raspberry Pi',
      troubleOpenwrt: 'OpenWrt / Turris',
      troubleWindows: 'Windows (PowerShell as administrator)',
      troubleDocker: 'Docker (the container output)',
      troubleSilent: `The server marks an agent monitor down after ${AGENT_OFFLINE_DEFAULT_MINUTES} minutes without a report. The limit is in ${app('nav.settings')} → ${app('settings.agent_offline_timeout_label')}; 0 turns the check off.`,
      compactMore: 'Registering many machines with one token, and what to check when an agent does not show up:',
      compactLink: 'on the download page',
    };

// The uninstall steps: the same crontab idiom as the install, through
// `crontab`, never by editing /etc/crontabs/root, which Turris OS (cronie)
// ignores. `|| true` keeps the pipeline going when there is no crontab.
const shellRemove = [
  `( crontab -l 2>/dev/null | grep -v /opt/bk-agent/agent.sh || true ) | crontab -`,
  'rm -rf /opt/bk-agent',
].join('\n');

const ICONS = {
  terminal: 'M4 17l6-6-6-6M12 19h8',
  router: 'M4 14h16a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2zM6 17.5h.01M10 17.5h.01M15 10v4M17.8 7.2a4 4 0 0 0-5.6 0M20.7 4.3a8 8 0 0 0-11.4 0',
  windows: 'M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM3 12h18M12 3v18',
  box: 'M21 8l-9-5-9 5v8l9 5 9-5zM3 8l9 5 9-5M12 13v8',
  chip: 'M8 6h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zM9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4',
};

// "Read the script first" opens the source in the agents repository, not a
// copy served by somebody's instance.
const source = (file: string) => ({ name: file, href: `${AGENTS_SOURCE_URL}/${file}` });

const panels: {
  id: string;
  platform: AgentPlatform;
  icon: string;
  label: string;
  agent: string;
  desc: string;
  needs: string;
  scripts: { name: string; href: string }[];
  remove: string;
}[] = [
  {
    id: 'linux',
    platform: 'shell',
    icon: ICONS.terminal,
    label: 'Linux / VPS',
    agent: 'bash',
    desc: t.linux,
    needs: t.linuxNeeds,
    scripts: [source('agent.sh')],
    remove: shellRemove,
  },
  {
    id: 'openwrt',
    platform: 'openwrt',
    icon: ICONS.router,
    label: 'OpenWrt / Turris',
    agent: 'openwrt',
    desc: t.openwrt,
    needs: t.openwrtNeeds,
    scripts: [source('agent_openwrt.sh')],
    remove: [
      `( crontab -l 2>/dev/null | grep -v agent_openwrt.sh || true ) | crontab -`,
      'rm -f /usr/bin/agent_openwrt.sh /usr/bin/agent_openwrt.cfg',
      'rm -rf /var/run/status-agent-openwrt /tmp/status-agent-openwrt*',
    ].join('\n'),
  },
  {
    id: 'windows',
    platform: 'windows',
    icon: ICONS.windows,
    label: 'Windows',
    agent: 'powershell',
    desc: t.windows,
    needs: t.windowsNeeds,
    scripts: [source('agent.ps1')],
    remove: ['Unregister-ScheduledTask -TaskName "BloodKingsAgent" -Confirm:$false', 'Remove-Item -Recurse -Force C:\\bloodkings'].join(
      '\n'
    ),
  },
  {
    id: 'docker',
    platform: 'docker',
    icon: ICONS.box,
    label: 'Docker',
    agent: 'python',
    desc: t.docker,
    needs: t.dockerNeeds,
    scripts: [source('agent.py'), source('docker-compose.agent.yml')],
    remove: ['cd /opt/bk-agent && docker compose -f docker-compose.agent.yml down', 'rm -rf /opt/bk-agent'].join('\n'),
  },
  {
    id: 'raspberry',
    platform: 'shell',
    icon: ICONS.chip,
    label: 'Raspberry Pi',
    agent: 'bash',
    desc: t.raspberry,
    needs: t.raspberryNeeds,
    scripts: [source('agent.sh')],
    remove: shellRemove,
  },
];

const stepsOf = (platform: AgentPlatform) => siteInstallSteps(platform, lang);

const register = [
  { id: 'shell', label: t.registerShell, command: registerCommand('shell') },
  { id: 'openwrt', label: t.registerOpenwrt, command: registerCommand('openwrt') },
];

const trouble = [
  {
    id: 'linux',
    label: t.troubleLinux,
    command: ['crontab -l | grep agent.sh', '/opt/bk-agent/agent.sh --verbose', 'tail -n 50 /opt/bk-agent/agent.log'].join(
      '\n'
    ),
  },
  {
    id: 'openwrt',
    label: t.troubleOpenwrt,
    command: [
      'crontab -l | grep agent_openwrt.sh',
      '/usr/bin/agent_openwrt.sh --verbose',
      'tail -n 50 /tmp/status-agent-openwrt.log; logread | grep -i agent | tail -n 20',
    ].join('\n'),
  },
  {
    id: 'windows',
    label: t.troubleWindows,
    command: [
      'Get-ScheduledTask -TaskName "BloodKingsAgent"',
      'powershell.exe -ExecutionPolicy Bypass -File C:\\bloodkings\\agent.ps1 -Verbose',
      'Get-Content C:\\bloodkings\\agent.log -Tail 50',
    ].join('\n'),
  },
  {
    id: 'docker',
    label: t.troubleDocker,
    command: 'cd /opt/bk-agent && docker compose -f docker-compose.agent.yml logs --tail 50',
  },
];
---

<div class="installer" id="install-guide" data-copied={t.copied} data-copy-failed={t.copyFailed}>
  <p class="inst-lead">{t.inApp}</p>
  <div class="inst-tabs" role="tablist" aria-label={t.tabs}>
    {
      panels.map((p, i) => (
        <button
          type="button"
          role="tab"
          class="inst-tab"
          id={`tab-${p.id}`}
          aria-controls={`panel-${p.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={p.icon} />
          </svg>
          {p.label}
        </button>
      ))
    }
  </div>

  {
    panels.map((p, i) => (
      <div
        class="inst-panel"
        role="tabpanel"
        id={`panel-${p.id}`}
        aria-labelledby={`tab-${p.id}`}
        data-platform={p.platform}
        tabindex="0"
        hidden={i !== 0}
      >
        <div class="inst-info">
          <p class="inst-desc">{p.desc}</p>
          <dl class="inst-facts">
            <div>
              <dt>{t.version}</dt>
              <dd class="tabular" data-agent-version={p.agent}>
                —
              </dd>
            </div>
            <div>
              <dt>{t.needs}</dt>
              <dd>{p.needs}</dd>
            </div>
            <div>
              <dt>{t.readFirst}</dt>
              <dd class="inst-scripts">
                {p.scripts.map((s) => (
                  <a href={s.href} rel="noopener">
                    {s.name}
                  </a>
                ))}
              </dd>
            </div>
          </dl>
        </div>

        <div class="inst-code">
          <p class="code-head">{t.install}</p>
          <ol class="inst-steps">
            {stepsOf(p.platform).map((s) => (
              <li class="inst-step" data-step-id={s.id}>
                <div class="step-head">
                  <p class="step-title" data-step-title>
                    {s.title}
                  </p>
                  <button
                    type="button"
                    class="copy-btn"
                    data-target={`step-${p.id}-${s.id}`}
                    aria-label={`${t.copy}: ${s.title}`}
                  >
                    {t.copy}
                  </button>
                </div>
                <pre><code id={`step-${p.id}-${s.id}`} data-step-command>{s.command}</code></pre>
                {s.note && (
                  <p class="inst-note" data-step-note>
                    {s.note}
                  </p>
                )}
              </li>
            ))}
          </ol>
          <div class="code-head">
            <span>{t.uninstall}</span>
            <button type="button" class="copy-btn" data-target={`remove-${p.id}`} aria-label={`${t.copy}: ${t.uninstall}`}>
              {t.copy}
            </button>
          </div>
          <pre><code id={`remove-${p.id}`}>{p.remove}</code></pre>
          <p class="inst-note">{t.uninstallNote}</p>
        </div>
      </div>
    ))
  }

  {
    variant === 'full' ? (
      <div class="inst-extra">
        <section class="inst-block" id="agent-register" aria-labelledby="agent-register-title">
          <h3 id="agent-register-title">{t.registerTitle}</h3>
          <p>{t.registerText}</p>
          {register.map((r) => (
            <div class="inst-labelled">
              <div class="code-head">
                <span>{r.label}</span>
                <button type="button" class="copy-btn" data-target={`register-${r.id}`} aria-label={`${t.copy}: ${r.label}`}>
                  {t.copy}
                </button>
              </div>
              <pre><code id={`register-${r.id}`}>{r.command}</code></pre>
            </div>
          ))}
          <p class="inst-note">{t.registerToken}</p>
        </section>

        <section class="inst-block" id="agent-trouble" aria-labelledby="agent-trouble-title">
          <h3 id="agent-trouble-title">{t.troubleTitle}</h3>
          <p>{t.troubleText}</p>
          {trouble.map((r) => (
            <div class="inst-labelled">
              <div class="code-head">
                <span>{r.label}</span>
                <button type="button" class="copy-btn" data-target={`trouble-${r.id}`} aria-label={`${t.copy}: ${r.label}`}>
                  {t.copy}
                </button>
              </div>
              <pre><code id={`trouble-${r.id}`}>{r.command}</code></pre>
            </div>
          ))}
          <p class="inst-note">{t.troubleSilent}</p>
        </section>
      </div>
    ) : (
      <p class="inst-more">
        {t.compactMore} <a href={`${prefix}/download/#agent-register`}>{t.compactLink} →</a>
      </p>
    )
  }
  <p class="visually-hidden" id="copy-status" aria-live="polite"></p>
</div>

<script>
  import { API_ORIGIN } from '../config';

  const root = document.getElementById('install-guide');
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.inst-tab'));

  // WAI-ARIA tabs: arrows move between tabs, Home/End jump to the ends.
  const select = (tab: HTMLButtonElement, focus: boolean) => {
    for (const other of tabs) {
      const selected = other === tab;
      other.setAttribute('aria-selected', String(selected));
      other.tabIndex = selected ? 0 : -1;
      const panel = document.getElementById(other.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !selected;
    }
    if (focus) tab.focus();
  };

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab, false));
    tab.addEventListener('keydown', (e) => {
      const last = tabs.length - 1;
      const to =
        e.key === 'ArrowRight' ? (i === last ? 0 : i + 1)
        : e.key === 'ArrowLeft' ? (i === 0 ? last : i - 1)
        : e.key === 'Home' ? 0
        : e.key === 'End' ? last
        : -1;
      if (to < 0) return;
      e.preventDefault();
      select(tabs[to], true);
    });
  });

  const status = document.getElementById('copy-status');
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = document.getElementById(btn.dataset.target ?? '');
      if (!code || !status) return;
      try {
        await navigator.clipboard.writeText(code.textContent?.trim() ?? '');
        status.textContent = root?.dataset.copied ?? '';
        btn.dataset.done = 'true';
        setTimeout(() => delete btn.dataset.done, 1800);
      } catch {
        status.textContent = root?.dataset.copyFailed ?? '';
      }
    });
  });

  // Per-platform versions from the worker, which reads them from the
  // published scripts. A version it could not read is null and stays a dash.
  async function loadAgentVersions() {
    let versions: Record<string, unknown> = {};
    try {
      const res = await fetch(`${API_ORIGIN}/api/agents`);
      // A 503 still carries the versions that were read, with null for the rest.
      versions = (await res.json()) as Record<string, unknown>;
    } catch {
      versions = {};
    }
    document.querySelectorAll<HTMLElement>('[data-agent-version]').forEach((badge) => {
      const value = versions[badge.dataset.agentVersion ?? ''];
      badge.textContent = typeof value === 'string' && /^\d[\w.-]*$/.test(value) ? `v${value}` : '—';
    });
  }

  loadAgentVersions();
</script>

<style>
  .installer {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    overflow: hidden;
  }

  /* --text-mid for body-size text: dark --text-low on --surface-1 is
     3.8:1, under WCAG's 4.5:1 (PA-3). */
  .inst-lead {
    padding: 1rem clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--text-mid);
  }

  .inst-tabs {
    display: flex;
    gap: 0.25rem;
    padding: 0.4rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-0);
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .inst-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-mid);
    cursor: pointer;
    white-space: nowrap;
  }

  .inst-tab svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .inst-tab:hover {
    color: var(--text-hi);
  }

  .inst-tab[aria-selected='true'] {
    background: var(--surface-2);
    border-color: var(--border-strong);
    color: var(--text-hi);
  }

  .inst-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.25rem, 1rem + 2vw, 2.5rem);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }

  .inst-panel[hidden] {
    display: none;
  }

  .inst-panel:focus-visible {
    outline-offset: -3px;
  }

  .inst-desc {
    font-size: var(--text-sm);
  }

  .inst-facts {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .inst-facts dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-low);
    margin-bottom: 0.2rem;
  }

  .inst-facts dd {
    font-size: var(--text-sm);
    color: var(--text-mid);
  }

  .inst-facts dd[data-agent-version] {
    font-family: var(--font-mono);
    color: var(--text-hi);
  }

  .inst-scripts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
