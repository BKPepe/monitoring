---
// AgentSelector.astro - installation panels and agent switcher.
//
// Every command here is one the scripts really accept. The page used to show
// a Docker image that was never published, a PowerShell install function
// that does not exist, an install.sh that is not served, and `--register TOKEN` without the server address, so
// agent.sh registered against its localhost default. The steps now mirror
// the app's own install guide (apps/monitor/src/lib/agent-install.ts):
// `agent.sh --register TOKEN API_URL` for the shell agents, agent.cfg for
// PowerShell, and the served docker-compose.agent.yml (python:3-alpine) for Docker.
//
// Versions come from the worker's /api/agents, which reads the published
// scripts; until it answers, and when it fails, the badge shows a dash.
const currentPath = Astro.url.pathname;
const isCs = currentPath.startsWith('/cs') || currentPath === '/cs';

const BASE = 'https://bloodkings.eu/status';
const API_URL = `${BASE}/agent_api.php`;

const t = isCs ? {
  badge: 'Instalace agenta',
  title: 'Nainstalujte agenta několika příkazy',
  desc: 'Vyberte platformu a zkopírujte příkazy. Registrační token a klíče agentů najdete v administraci. Adresy míří na server bloodkings.eu, na vlastní instanci je nahraďte její adresou.',
  versionLabel: 'Verze agenta:',
  imageLabel: 'Obraz:',
  linuxDesc: 'Bash agent bez závislostí (stačí curl). Příkaz --register ho přihlásí registračním tokenem a klíč uloží do agent.cfg vedle skriptu, cron ho pak spouští každých 5 minut.',
  openwrtDesc: 'Úsporný ash skript pro OpenWrt a Turris, bez bashe a Pythonu. Registrace uloží klíč do agent_openwrt.cfg, cron ho spouští každou minutu.',
  windowsDesc: 'PowerShell agent (5.1+). Nemá registrační příkaz: klíč agenta z nastavení monitoru uložte do agent.cfg a Plánovač úloh ho spustí každých 5 minut (PowerShell jako správce).',
  dockerDesc: 'Python agent v kontejneru python:3-alpine s pid: host, takže hlásí metriky hostitele, ne kontejneru. Doplňte klíč agenta z nastavení monitoru.',
  raspberryDesc: 'Stejný Bash agent jako na Linuxu, běží na ARMv7 i ARM64 bez dalších balíčků kromě curl.',
  copy: 'Zkopírovat',
  copied: 'Zkopírováno!'
} : {
  badge: 'Agent installation',
  title: 'Install an Agent in a Few Commands',
  desc: "Choose your platform and copy the commands. The registration token and agent keys are in the admin. The addresses point at the bloodkings.eu server; on your own instance, use its address instead.",
  versionLabel: 'Agent Version:',
  imageLabel: 'Image:',
  linuxDesc: 'A dependency-free Bash agent (curl is enough). --register enrols it with the registration token and stores its key in agent.cfg next to the script; cron then runs it every 5 minutes.',
  openwrtDesc: 'A lean ash script for OpenWrt and Turris, no bash or Python needed. Registration stores its key in agent_openwrt.cfg; cron runs it every minute.',
  windowsDesc: "A PowerShell agent (5.1+). It has no register command: put the agent key from the monitor's settings into agent.cfg, and the Task Scheduler runs it every 5 minutes (run PowerShell as administrator).",
  dockerDesc: "The Python agent in a python:3-alpine container with pid: host, so it reports the host's metrics, not the container's. Fill in the agent key from the monitor's settings.",
  raspberryDesc: 'The same Bash agent as on Linux; it runs on ARMv7 and ARM64 with nothing but curl.',
  copy: 'Copy',
  copied: 'Copied!'
};

// The same crontab idiom as the app: through `crontab`, never by appending
// to /etc/crontabs/root, which Turris OS (cronie) ignores. The mkdir is for
// cronie's backup directory, which does not exist on a Turris. `|| true`
// keeps the new line when there is no crontab yet and the steps run under
// `set -e`: without it the subshell stops at the failing `crontab -l` and an
// EMPTY crontab is installed without a word.
const shellSteps = [
  `mkdir -p /opt/bk-agent && curl -fsSL -o /opt/bk-agent/agent.sh ${BASE}/agent.sh && chmod +x /opt/bk-agent/agent.sh`,
  `/opt/bk-agent/agent.sh --register YOUR_REGISTRATION_TOKEN ${API_URL}`,
  `( crontab -l 2>/dev/null || true; echo '*/5 * * * * /opt/bk-agent/agent.sh >/dev/null 2>&1' ) | crontab -`,
].join('\n');

const panels = [
  {
    id: 'linux',
    icon: '🐧',
    label: 'Linux / VPS',
    agent: 'bash',
    desc: t.linuxDesc,
    lang: 'bash',
    code: shellSteps,
  },
  {
    id: 'openwrt',
    icon: '📡',
    label: 'OpenWrt / Turris',
    agent: 'openwrt',
    desc: t.openwrtDesc,
    lang: 'bash',
    code: [
      `wget -O /usr/bin/agent_openwrt.sh ${BASE}/agent_openwrt.sh && chmod +x /usr/bin/agent_openwrt.sh`,
      `/usr/bin/agent_openwrt.sh --register YOUR_REGISTRATION_TOKEN ${API_URL}`,
      `mkdir -p "\${HOME:-/root}/.cache/crontab" && ( crontab -l 2>/dev/null | grep -v agent_openwrt.sh || true; echo '* * * * * /usr/bin/agent_openwrt.sh >/dev/null 2>&1' ) | crontab -`,
    ].join('\n'),
  },
  {
    id: 'windows',
    icon: '🪟',
    label: 'Windows',
    agent: 'powershell',
    desc: t.windowsDesc,
    lang: 'powershell',
    code: [
      `New-Item -ItemType Directory -Force C:\\bloodkings | Out-Null; Invoke-WebRequest -Uri "${BASE}/agent.ps1" -OutFile C:\\bloodkings\\agent.ps1`,
      `Set-Content -Path C:\\bloodkings\\agent.cfg -Value @('API_URL="${API_URL}"', 'AGENT_KEY="YOUR_AGENT_KEY"')`,
      `$action = New-ScheduledTaskAction -Execute "powershell.exe" -Argument '-ExecutionPolicy Bypass -File "C:\\bloodkings\\agent.ps1"'`,
      '$trigger = New-ScheduledTaskTrigger -Once -At (Get-Date) -RepetitionInterval (New-TimeSpan -Minutes 5) -RepetitionDuration (New-TimeSpan -Days 3650)',
      'Register-ScheduledTask -TaskName "BloodKingsAgent" -Action $action -Trigger $trigger -User "SYSTEM" -RunLevel Highest',
    ].join('\n'),
  },
  {
    id: 'docker',
    icon: '🐳',
    label: 'Docker',
    agent: 'python',
    image: 'python:3-alpine',
    desc: t.dockerDesc,
    lang: 'bash',
    code: [
      `mkdir -p /opt/bk-agent && cd /opt/bk-agent && curl -fsSL -o agent.py ${BASE}/agent.py && curl -fsSL -o docker-compose.agent.yml ${BASE}/docker-compose.agent.yml`,
      `sed -i 's|STATUS_API_URL: .*|STATUS_API_URL: "${API_URL}"|; s|STATUS_AGENT_KEY: .*|STATUS_AGENT_KEY: "YOUR_AGENT_KEY"|' docker-compose.agent.yml`,
      'docker compose -f docker-compose.agent.yml up -d',
    ].join('\n'),
  },
  {
    id: 'raspberry',
    icon: '🍓',
    label: 'Raspberry Pi',
    agent: 'bash',
    desc: t.raspberryDesc,
    lang: 'bash',
    code: shellSteps,
  },
];
---

<div class="agent-selector-card card" id="install-guide">
  <div class="selector-header">
    <span class="badge badge-success">{t.badge}</span>
    <h3>{t.title}</h3>
    <p>{t.desc}</p>
  </div>

  <div class="tabbed-selector">
    <!-- Tabs selectors -->
    <div class="tabs-nav">
      {panels.map((panel, i) => (
        <button class:list={['tab-btn', { active: i === 0 }]} data-platform={panel.id}>
          <span>{panel.icon}</span> {panel.label}
        </button>
      ))}
    </div>

    <!-- Tab contents -->
    <div class="tab-contents">
      {panels.map((panel, i) => (
        <div class:list={['tab-panel', { active: i === 0 }]} id={`panel-${panel.id}`}>
          <div class="panel-meta">
            <div class="meta-row">
              <span class="meta-label">{t.versionLabel}</span>
              <span class="meta-val badge badge-accent tabular" data-agent-version={panel.agent}>—</span>
              {panel.image && (
                <>
                  <span class="meta-label">{t.imageLabel}</span>
                  <span class="meta-val badge badge-accent">{panel.image}</span>
                </>
              )}
            </div>
            <p>{panel.desc}</p>
          </div>
          <div class="code-block-wrapper">
            <pre><code class={`language-${panel.lang}`} id={`code-${panel.id}`}>{panel.code}</code></pre>
            <button class="copy-code-btn" data-target={`code-${panel.id}`} aria-label={t.copy}>
              <span class="copy-txt">{t.copy}</span>
              <span class="copied-txt">{t.copied}</span>
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  import { API_ORIGIN } from '../config';

  // Dynamic tab switcher
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const platform = btn.getAttribute('data-platform');

      tabBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      tabPanels.forEach((panel) => {
        panel.classList.toggle('active', panel.id === `panel-${platform}`);
      });
    });
  });

  // Copy to clipboard
  document.querySelectorAll('.copy-code-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const targetId = btn.getAttribute('data-target');
      const codeElement = targetId ? document.getElementById(targetId) : null;
      if (!codeElement) return;

      try {
        await navigator.clipboard.writeText(codeElement.textContent ?? '');
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 2000);
      } catch (err) {
        console.error('Failed to copy to clipboard:', err);
      }
    });
  });

  // Per-platform versions from the worker, which reads them from the
  // published scripts. A version it could not read is null and stays a dash;
  // nothing here falls back to a number written into the page.
  async function loadAgentVersions() {
    let versions: Record<string, unknown> = {};
    try {
      const res = await fetch(`${API_ORIGIN}/api/agents`);
      // A 503 still carries the versions that were read, with null for the rest.
      versions = (await res.json()) as Record<string, unknown>;
    } catch {
      versions = {};
    }

    document.querySelectorAll<HTMLElement>('[data-agent-version]').forEach((badge) => {
      const value = versions[badge.dataset.agentVersion ?? ''];
      // Only a version-shaped string counts; an older worker answered "unknown".
      badge.textContent = typeof value === 'string' && /^\d[\w.-]*$/.test(value) ? `v${value}` : '—';
    });
  }

  loadAgentVersions();
</script>

<style>
  .agent-selector-card {
    background: var(--surface-1);
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 3rem;
  }

  .selector-header h3 {
    font-size: 1.8rem;
    margin-top: 0.5rem;
  }

  .selector-header p {
    font-size: 0.95rem;
    color: var(--text-mid);
    margin-top: 0.5rem;
    max-width: 600px;
  }

  /* Tab Nav */
  .tabs-nav {
    display: flex;
    gap: 0.5rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 0.4rem;
    border-radius: var(--radius-sm);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .tab-btn {
    flex-grow: 1;
    background: transparent;
    border: none;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-mid);
    border-radius: var(--radius-sm);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all var(--transition-fast);
  }

  .tab-btn:hover {
    color: var(--text-hi);
    background: rgba(0, 0, 0, 0.02);
  }

  :global(.dark) .tab-btn:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .tab-btn.active {
    background: var(--surface-1);
    color: var(--text-hi);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
  }

  /* Tab Panel Content */
  .tab-panel {
    display: none;
    flex-direction: column;
    gap: 1.5rem;
  }

  .tab-panel.active {
    display: flex;
  }

  .panel-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .meta-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-low);
  }

  .meta-val {
    font-size: 0.85rem;
  }

  .tab-panel p {
    font-size: 0.95rem;
  }

  /* Code Block Box */
  .code-block-wrapper {
    position: relative;
    background: #09090b;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-sm);
    padding: 1.2rem 4rem 1.2rem 1.5rem;
    display: flex;
    align-items: center;
  }

  .code-block-wrapper pre {
    width: 100%;
    margin: 0;
    overflow-x: auto;
  }

  .code-block-wrapper code {
    color: #f4f4f5;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .copy-code-btn {
    position: absolute;
    right: 1.2rem;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #a1a1aa;
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .copy-code-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
  }

  .copy-code-btn .copied-txt {
    display: none;
    color: var(--up);
  }

  .copy-code-btn.copied {
    border-color: var(--up);
    background: rgba(64, 192, 87, 0.1);
  }

  .copy-code-btn.copied .copy-txt {
    display: none;
  }

  .copy-code-btn.copied .copied-txt {
    display: inline;
  }

  @media (max-width: 768px) {
    .agent-selector-card {
      padding: 1.5rem;
    }
    .tabs-nav {
      flex-direction: column;
    }
    .code-block-wrapper {
      padding: 1.2rem 1.2rem 4rem 1.2rem;
      align-items: flex-start;
    }
    .copy-code-btn {
      top: auto;
      bottom: 1.2rem;
      right: 1.2rem;
      transform: none;
    }
  }
</style>
