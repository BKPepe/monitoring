---
// AgentNetwork.astro - architecture diagram: agents push to one central server.
//
// The diagram is an illustration of the supported platforms, so its nodes
// carry no numbers (they used to show invented pings of 4-45 ms). The header
// line above it is live: it reads the shared /api/status answer
// (lib/live-status) and says "communicating without errors" only when every
// reporting agent is online and the data is fresh. It used to say that
// unconditionally, next to a hard-coded "24 ms".
const currentPath = Astro.url.pathname;
const isCs = currentPath.startsWith('/cs') || currentPath === '/cs';
const t = isCs
  ? {
      loading: 'Načítám živý stav agentů…',
      allOk: 'Agenti komunikují bez chyb',
      partial: 'agentů online',
      none: 'Zatím se nehlásí žádný agent',
      stale: 'Živá data jsou stará - sběr se možná zastavil',
      unavailable: 'Živý stav agentů je teď nedostupný',
      latency: 'Průměrná odezva (1 h)',
      illustration: 'Schéma je ilustrace podporovaných platforem, ne živá data.',
    }
  : {
      loading: 'Loading live agent state…',
      allOk: 'Agents communicating without errors',
      partial: 'agents online',
      none: 'No agent is reporting yet',
      stale: 'Live data is stale - collection may have stopped',
      unavailable: 'Live agent state is unavailable right now',
      latency: 'Average response (1 h)',
      illustration: 'The diagram illustrates the supported platforms; it is not live data.',
    };
---

<div class="network-container card">
  <div
    class="network-header"
    aria-live="polite"
    data-all-ok={t.allOk}
    data-partial={t.partial}
    data-none={t.none}
    data-stale={t.stale}
    data-unavailable={t.unavailable}
  >
    <div class="status-indicator">
      <span class="pulse-dot neutral" data-live="net-dot"></span>
      <span class="status-label" data-live="net-label">{t.loading}</span>
    </div>
    <span class="ping-stats">{t.latency}: <strong class="tabular" data-live="net-latency">—</strong></span>
  </div>

  <div class="network-visualizer">
    <svg viewBox="0 0 800 500" class="network-svg">
      <!-- Defs for gradients & filters -->
      <defs>
        <radialGradient id="server-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="var(--brand-500)" stop-opacity="0.3"></stop>
          <stop offset="100%" stop-color="var(--brand-500)" stop-opacity="0"></stop>
        </radialGradient>
        <radialGradient id="node-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#2b8a3e" stop-opacity="0.2"></stop>
          <stop offset="100%" stop-color="#2b8a3e" stop-opacity="0"></stop>
        </radialGradient>
        <filter id="glow-effect" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="6" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>

      <!-- Connection Lines with Animated Pulses -->
      <g class="connections">
        <line x1="200" y1="90" x2="400" y2="250" class="connection-line c-openwrt" />
        <line x1="600" y1="90" x2="400" y2="250" class="connection-line c-linux" />
        <line x1="140" y1="250" x2="400" y2="250" class="connection-line c-windows" />
        <line x1="660" y1="250" x2="400" y2="250" class="connection-line c-docker" />
        <line x1="220" y1="410" x2="400" y2="250" class="connection-line c-raspberry" />
        <line x1="580" y1="410" x2="400" y2="250" class="connection-line c-vps" />
      </g>

      <!-- Glowing Server Backing -->
      <circle cx="400" cy="250" r="110" fill="url(#server-glow)" />

      <!-- Center Server Node -->
      <g class="node server-node" id="server-center">
        <circle cx="400" cy="250" r="48" class="node-bg server-bg" />
        <circle cx="400" cy="250" r="40" class="node-border server-border" />
        <text x="400" y="259" class="node-icon server-icon">👑</text>
        <text x="400" y="325" class="node-title server-title">{isCs ? 'CENTRÁLNÍ SERVER' : 'CENTRAL SERVER'}</text>
        <text x="400" y="342" class="node-subtitle">bloodkings.eu/status</text>
      </g>

      <!-- Surrounding Agent Nodes -->
      <!-- Agent 1: OpenWrt Router (top left) -->
      <g transform="translate(200, 90)">
        <g class="node agent-node online" data-slot="1">
          <circle cx="0" cy="0" r="32" class="node-bg" />
          <circle cx="0" cy="0" r="28" class="node-border" />
          <text x="0" y="8" class="node-icon">📡</text>
          <text x="0" y="-45" class="node-title">OpenWrt / Turris Router</text>
        </g>
      </g>

      <!-- Agent 2: Linux (top right) -->
      <g transform="translate(600, 90)">
        <g class="node agent-node online" data-slot="2">
          <circle cx="0" cy="0" r="32" class="node-bg" />
          <circle cx="0" cy="0" r="28" class="node-border" />
          <text x="0" y="8" class="node-icon">🐧</text>
          <text x="0" y="-45" class="node-title">Linux VPS (BASH)</text>
        </g>
      </g>

      <!-- Agent 3: Windows Server (mid left) -->
      <g transform="translate(140, 250)">
        <g class="node agent-node online" data-slot="3">
          <circle cx="0" cy="0" r="32" class="node-bg" />
          <circle cx="0" cy="0" r="28" class="node-border" />
          <text x="0" y="8" class="node-icon">🪟</text>
          <text x="0" y="-45" class="node-title">Windows (PowerShell)</text>
        </g>
      </g>

      <!-- Agent 4: Docker Container (mid right) -->
      <g transform="translate(660, 250)">
        <g class="node agent-node online" data-slot="4">
          <circle cx="0" cy="0" r="32" class="node-bg" />
          <circle cx="0" cy="0" r="28" class="node-border" />
          <text x="0" y="8" class="node-icon">🐳</text>
          <text x="0" y="-45" class="node-title">Docker Agent</text>
        </g>
      </g>

      <!-- Agent 5: Raspberry Pi (bottom left) -->
      <g transform="translate(220, 410)">
        <g class="node agent-node online" data-slot="5">
          <circle cx="0" cy="0" r="32" class="node-bg" />
          <circle cx="0" cy="0" r="28" class="node-border" />
          <text x="0" y="8" class="node-icon">🍓</text>
          <text x="0" y="-45" class="node-title">Raspberry Pi (Python)</text>
        </g>
      </g>

      <!-- Agent 6: Cloud VPS (bottom right) -->
      <g transform="translate(580, 410)">
        <g class="node agent-node online" data-slot="6">
          <circle cx="0" cy="0" r="32" class="node-bg" />
          <circle cx="0" cy="0" r="28" class="node-border" />
          <text x="0" y="8" class="node-icon">☁️</text>
          <text x="0" y="-45" class="node-title">Cloud Host (AWS/Hetzner)</text>
        </g>
      </g>
    </svg>
  </div>
  <p class="network-caption">{t.illustration}</p>

  <div class="network-legend-grid">
    <div class="legend-card">
      <span class="legend-icon">👑</span>
      <div>
        <strong>{isCs ? 'Centrální Server (Status App)' : 'Central Server (Status App)'}</strong>
        <p>{isCs ? 'Přijímá metriky od agentů, vyhodnocuje výpadky a odesílá notifikace (SMTP, Discord, Telegram, Webhooky).' : 'Receives metrics from agents, detects outages, and dispatches alerts (SMTP, Discord, Telegram, Webhooks).'}</p>
      </div>
    </div>
    <div class="legend-card">
      <span class="legend-icon">📡</span>
      <div>
        <strong>{isCs ? 'Vzdálení Agenti' : 'Remote Agents'}</strong>
        <p>{isCs ? 'Lehké skripty pro OpenWrt, Linux BASH, Python 3 a PowerShell odesílající systémová data bez nároků na paměť.' : 'Ultra-light scripts for OpenWrt, Linux BASH, Python 3, and PowerShell reporting health data without overhead.'}</p>
      </div>
    </div>
  </div>
</div>

<script>
  import { dash, onLiveStatus } from '../lib/live-status';

  const header = document.querySelector<HTMLElement>('.network-header');
  const dot = header?.querySelector<HTMLElement>('[data-live="net-dot"]');
  const label = header?.querySelector<HTMLElement>('[data-live="net-label"]');
  const latency = header?.querySelector<HTMLElement>('[data-live="net-latency"]');

  function show(text: string, tone: 'green' | 'warning' | 'neutral') {
    if (label) label.textContent = text;
    if (dot) dot.className = `pulse-dot ${tone}`;
  }

  onLiveStatus((result) => {
    const words: DOMStringMap = header?.dataset ?? {};
    if (!result.ok) {
      show(words.unavailable ?? '', 'neutral');
      if (latency) latency.textContent = '—';
      return;
    }

    const d = result.data;
    if (latency) latency.textContent = d.fresh ? dash(d.avgLatencyMs, ' ms') : '—';

    if (!d.fresh) {
      show(words.stale ?? '', 'neutral');
    } else if (!d.agentsTotal) {
      show(words.none ?? '', 'neutral');
    } else if (d.agentsOnline === d.agentsTotal && d.verdict === 'healthy') {
      show(words.allOk ?? '', 'green');
    } else {
      // All agents up next to an outage elsewhere is a count, not "without errors".
      const tone = d.agentsOnline === d.agentsTotal ? 'neutral' : 'warning';
      show(`${dash(d.agentsOnline)} / ${d.agentsTotal} ${words.partial ?? ''}`, tone);
    }
  });
</script>

<style>
  .network-container {
    width: 100%;
    background: var(--surface-1);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2.5rem;
    position: relative;
  }

  .network-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.2rem;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .pulse-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    position: relative;
  }

  .pulse-dot.green {
    background-color: var(--up);
    box-shadow: 0 0 10px var(--up);
  }

  .pulse-dot.green::after {
    content: '';
    position: absolute;
    top: -4px;
    left: -4px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--up);
    opacity: 0;
    animation: ping-pulse 1.8s infinite cubic-bezier(0.4, 0, 0.6, 1);
  }

  /* Nothing loaded yet, or no live answer: no colour and no pulse. */
  .pulse-dot.neutral {
    background-color: var(--text-low);
  }

  .pulse-dot.warning {
    background-color: var(--warning);
  }

  .network-caption {
    margin: -0.75rem 0 0;
    font-size: var(--text-xs);
    color: var(--text-low);
    text-align: center;
  }

  .status-label {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .ping-stats {
    font-size: 0.9rem;
    color: var(--text-mid);
  }

  .network-visualizer {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    background: radial-gradient(circle at 50% 50%, var(--surface-2) 0%, transparent 80%);
    border-radius: var(--radius-md);
    padding: 1rem;
    overflow: hidden;
  }

  .network-svg {
    width: 100%;
    max-height: 480px;
  }

  /* Node Styling */
  .node {
    cursor: pointer;
    transition: transform var(--transition-normal);
  }

  .node-bg {
    fill: var(--surface-1);
    stroke: var(--border);
    stroke-width: 1.5;
    transition: fill var(--transition-normal), stroke var(--transition-normal);
  }

  :global(.dark) .node-bg {
    fill: var(--surface-2);
  }

  .node-border {
    fill: none;
    stroke: var(--text-low);
    stroke-opacity: 0.2;
    stroke-width: 2;
    transition: stroke var(--transition-normal);
  }

  .node-icon {
    font-size: 20px;
    text-anchor: middle;
    user-select: none;
  }

  .node-title {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    fill: var(--text-hi);
    text-anchor: middle;
    opacity: 0.85;
    transition: opacity var(--transition-normal), font-size var(--transition-normal);
  }

  .node-subtitle {
    font-family: var(--font-sans);
    font-size: 10px;
    fill: var(--text-low);
    text-anchor: middle;
  }

  /* Server Node Specifics */
  .server-bg {
    fill: var(--surface-1);
    stroke: var(--brand-500);
    stroke-width: 2.5;
  }
  
  :global(.dark) .server-bg {
    fill: rgba(176, 0, 32, 0.05);
  }

  .server-border {
    stroke: var(--brand-500);
    stroke-opacity: 0.4;
    filter: url(#glow-effect);
  }

  .server-icon {
    font-size: 32px;
  }

  .server-title {
    font-size: 11px;
    letter-spacing: 0.1em;
    font-weight: 800;
    fill: var(--text-hi);
  }

  /* Hover Interactivity */
  .node:hover {
    transform: scale(1.1);
  }

  .agent-node:hover .node-border {
    stroke: var(--up);
    stroke-opacity: 0.8;
  }

  .server-node:hover {
    transform: scale(1.05);
  }

  /* Connections Line Styling */
  .connection-line {
    stroke: var(--border);
    stroke-width: 2.5;
    stroke-dasharray: 8, 8;
    fill: none;
    transition: stroke var(--transition-normal);
  }

  /* Animated connection styling */
  .agent-node.online {
    animation: agent-floating 8s ease-in-out infinite;
  }
  
  /* Apply delay to create a natural dynamic look. Each node sits in its own
     positioning <g>: a CSS transform (the float animation, the hover scale)
     replaces the SVG transform attribute on the same element, and the six
     nodes used to collapse onto the top-left corner of the diagram. */
  .agent-node[data-slot='2'] { animation-delay: -1s; }
  .agent-node[data-slot='3'] { animation-delay: -2.5s; }
  .agent-node[data-slot='4'] { animation-delay: -4s; }
  .agent-node[data-slot='5'] { animation-delay: -5.5s; }
  .agent-node[data-slot='6'] { animation-delay: -7s; }

  /* Red glowing flowing connection line style */
  .connection-line {
    animation: flow-line 25s linear infinite;
    stroke: rgba(176, 0, 32, 0.4);
  }

  :global(.dark) .connection-line {
    stroke: rgba(229, 57, 53, 0.35);
  }

  .node:hover + .connection-line,
  .connections:hover .connection-line {
    stroke: var(--brand-500);
    stroke-width: 3.5;
  }

  /* Animations definitions */
  @keyframes ping-pulse {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  @keyframes agent-floating {
    0% { transform: translate(0, 0); }
    50% { transform: translate(0, -6px); }
    100% { transform: translate(0, 0); }
  }

  @keyframes flow-line {
    to {
      stroke-dashoffset: -200px;
    }
  }

  /* Transform offset helpers because SVG translations inside HTML can differ */
  .agent-node {
    transform-origin: 0px 0px;
  }

  @media (max-width: 600px) {
    .network-container {
      padding: 1.5rem;
    }
    .network-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .node-title {
      font-size: 10px;
    }
  }
</style>
