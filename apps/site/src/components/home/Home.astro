---
// Home.astro - the landing page, one component for both languages. The
// pages (src/pages/index.astro, src/pages/cs/index.astro) only pick the
// language; all copy comes from src/i18n/{en,cs}.ts.
//
// No screenshots yet (owner's decision): the page is built from words,
// honest diagrams and live panels that show a dash until a real answer
// arrives. Nothing here draws the app with invented numbers.
import Layout from '../../layouts/Layout.astro';
import AgentSelector from '../AgentSelector.astro';
import Dashboard from '../Dashboard.astro';
import Icon from '../Icon.astro';
import Map from '../Map.astro';
import Playground from '../Playground.astro';
import RouterDiagram from './RouterDiagram.astro';
import { GITHUB_REPO_URL } from '../../config';
import { dicts, type Lang } from '../../i18n';
import type { IconName } from '../../lib/icons';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dicts[lang].home;
const prefix = lang === 'cs' ? '/cs' : '';
const SITE = 'https://monitoring.bloodkings.eu';
const LIVE_STATUS_URL = 'https://bloodkings.eu/app/public';
const AGENTS_README = 'https://github.com/BKPepe/monitoring-agent#what-019-made-lighter-openwrt';

const pageUrl = `${SITE}${prefix}/`;
const jsonLd = [
  {
    '@type': 'WebSite',
    '@id': `${SITE}/#website`,
    name: 'Blood Kings Monitoring',
    url: pageUrl,
    inLanguage: lang,
  },
  {
    '@type': 'SoftwareApplication',
    name: 'Blood Kings Monitoring',
    url: pageUrl,
    description: t.description,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Linux, Windows, OpenWrt',
    license: 'https://opensource.org/licenses/MIT',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    sameAs: [GITHUB_REPO_URL],
    inLanguage: ['en', 'cs'],
  },
  {
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: t.faq.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];

const pill = { available: t.watches.available, partial: t.watches.partial, planned: t.watches.planned };
---

<Layout title={t.title} description={t.description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1 id="hero-title">
          <span class="h1-a">{t.hero.titleA}</span>
          <span class="h1-b">{t.hero.titleB}</span>
        </h1>
        <p class="lead">{t.hero.sub}</p>
        <div class="hero-ctas">
          <a href="#install" class="btn btn-primary btn-lg">{t.hero.ctaInstall}</a>
          <a href={LIVE_STATUS_URL} class="btn btn-secondary btn-lg" rel="noopener">{t.hero.ctaLive}</a>
          <a href={GITHUB_REPO_URL} class="btn btn-ghost btn-lg" rel="noopener">{t.hero.ctaGithub}</a>
        </div>
      </div>
      <div class="hero-panel">
        <Dashboard lang={lang} />
      </div>
    </div>

    <div class="container">
      <ul class="facts" aria-label={t.factsLabel}>
        {
          t.facts.map((f) => (
            <li>
              <a href={f.href} rel={f.href.startsWith('http') ? 'noopener' : undefined}>
                <Icon name="check" size={16} class="fact-check" />
                <span>{f.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Routers -->
  <section class="section" id="routers" aria-labelledby="routers-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t.routers.eyebrow}</p>
        <h2 id="routers-title">{t.routers.title}</h2>
        <p class="lead">{t.routers.lead}</p>
      </div>

      <div class="routers-grid">
        <ul class="router-items">
          {
            t.routers.items.map((item) => (
              <li>
                <span class="tile">
                  <Icon name={item.icon as IconName} />
                </span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <div class="router-visual">
          <RouterDiagram lang={lang} />
        </div>
      </div>

      <div class="router-notes">
        <div class="note note-privacy">
          <span class="tile tile-brand"><Icon name="shield" /></span>
          <div>
            <h3>{t.routers.privacyTitle}</h3>
            <p>{t.routers.privacyBody}</p>
          </div>
        </div>
        <div class="note note-cost">
          <h3>{t.routers.costTitle}</h3>
          <dl class="cost">
            <div>
              <dt>{t.routers.costForksLabel}</dt>
              <dd>{t.routers.costForks}</dd>
            </div>
          </dl>
          <p class="cost-note">
            {t.routers.costNote}
            <a href={AGENTS_README} rel="noopener">{t.routers.costLink}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What it watches -->
  <section class="section band" aria-labelledby="watches-title">
    <div class="container">
      <div class="section-head section-head-row">
        <div class="section-head">
          <p class="eyebrow">{t.watches.eyebrow}</p>
          <h2 id="watches-title">{t.watches.title}</h2>
          <p class="lead">{t.watches.lead}</p>
        </div>
        <a class="text-link" href={`${prefix}/features/`}>
          {t.watches.more}
          <Icon name="arrow" size={16} />
        </a>
      </div>

      <ul class="watch-grid">
        {
          t.watches.cards.map((c) => (
            <li class="watch-card">
              <div class="watch-top">
                <span class="tile">
                  <Icon name={c.icon as IconName} />
                </span>
                <span class={`pill pill-${c.status}`}>{pill[c.status as keyof typeof pill]}</span>
              </div>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Live proof -->
  <section class="section" id="live" aria-labelledby="live-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t.live.eyebrow}</p>
        <h2 id="live-title">{t.live.title}</h2>
        <p class="lead">{t.live.lead}</p>
      </div>
      <div class="live-grid">
        <Map lang={lang} />
        <Playground lang={lang} />
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section band" aria-labelledby="how-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t.how.eyebrow}</p>
        <h2 id="how-title">{t.how.title}</h2>
      </div>
      <ol class="steps">
        {
          t.how.steps.map((s, i) => (
            <li class:list={['step', { 'step-wide': s.code }]}>
              <span class="step-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              {s.code && (
                <pre><code>{s.code}</code></pre>
              )}
              {s.after && <p class="step-after">{s.after}</p>}
            </li>
          ))
        }
      </ol>
      <a class="text-link" href={`${prefix}/docs/#quickstart`}>
        {t.how.docsLink}
        <Icon name="arrow" size={16} />
      </a>
    </div>
  </section>

  <!-- Install -->
  <section class="section" id="install" aria-labelledby="install-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t.install.eyebrow}</p>
        <h2 id="install-title">{t.install.title}</h2>
        <p class="lead">{t.install.lead}</p>
      </div>
      <AgentSelector lang={lang} />
    </div>
  </section>

  <!-- Scope and FAQ -->
  <section class="section band" aria-labelledby="limits-title">
    <div class="container scope-grid">
      <div class="limits">
        <p class="eyebrow">{t.limits.eyebrow}</p>
        <h2 id="limits-title">{t.limits.title}</h2>
        <ul>
          {
            t.limits.items.map((item) => (
              <li>
                <Icon name="minus" size={16} class="limit-mark" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <a class="text-link" href={`${prefix}/roadmap/`}>
          {t.limits.roadmap}
          <Icon name="arrow" size={16} />
        </a>
      </div>

      <div class="faq" id="faq">
        <p class="eyebrow">{t.faq.eyebrow}</p>
        <h2>{t.faq.title}</h2>
        <div class="faq-list">
          {
            t.faq.items.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Why it exists -->
  <section class="section" aria-labelledby="story-title">
    <div class="container">
      <div class="story">
        <div class="story-copy">
          <p class="eyebrow">{t.story.eyebrow}</p>
          <h2 id="story-title">{t.story.title}</h2>
          {t.story.body.map((p) => <p>{p}</p>)}
          <div class="story-ctas">
            <a class="btn btn-primary" href="#install">{t.hero.ctaInstall}</a>
            <a class="btn btn-ghost" href={`${prefix}/about/`}>{t.story.link}</a>
          </div>
        </div>
        <div class="story-mark" aria-hidden="true">
          <span class="dash">—</span>
          <span class="dash-label">{t.story.markLabel}</span>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* --- Hero ------------------------------------------------------------ */
  .hero {
    position: relative;
    padding-block: clamp(3rem, 1.5rem + 6vw, 6.5rem) 0;
    overflow: hidden;
    isolation: isolate;
  }

  /* One light and a faint grid, both behind the content. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 20%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 70% 20%, #000 20%, transparent 75%);
  }

  .hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: -18rem;
    right: -10rem;
    width: min(60rem, 90vw);
    aspect-ratio: 1;
    background: radial-gradient(circle, color-mix(in oklab, var(--brand-600) 16%, transparent), transparent 62%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }

  h1 {
    display: grid;
    gap: 0.1em;
    font-size: clamp(2.35rem, 1.5rem + 3.1vw, 3.9rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    font-weight: 700;
  }

  .h1-b {
    color: var(--text-mid);
    text-decoration: underline;
    text-decoration-color: var(--brand-500);
    text-decoration-thickness: 0.05em;
    text-underline-offset: 0.14em;
    text-decoration-skip-ink: none;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  .hero-panel {
    min-width: 0;
  }

  .facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .facts a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--surface-1);
    font-size: var(--text-sm);
    color: var(--text-mid);
  }

  .facts a:hover {
    color: var(--text-hi);
    border-color: var(--border-strong);
  }

  .facts :global(.fact-check) {
    color: var(--up);
    flex-shrink: 0;
  }

  /* --- Shared pieces ----------------------------------------------------- */
  .band {
    background: var(--surface-1);
    border-block: 1px solid var(--border);
  }

  .tile {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text-hi);
  }

  .tile-brand {
    color: var(--brand-500);
    background: color-mix(in oklab, var(--brand-500) 10%, transparent);
    border-color: color-mix(in oklab, var(--brand-500) 30%, transparent);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 2rem;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--brand-500);
  }

  .text-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* --- Routers ----------------------------------------------------------- */
  .routers-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    align-items: start;
  }

  .router-items {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 2rem;
  }

  .router-items li {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .router-items p {
    margin-top: 0.4rem;
    font-size: var(--text-sm);
  }

  .router-visual {
    position: sticky;
    top: calc(var(--header-height) + 1.5rem);
  }

  .router-notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .note {
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
  }

  .note-privacy {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    border-color: color-mix(in oklab, var(--brand-500) 30%, var(--border));
  }

  .note p {
    margin-top: 0.4rem;
    font-size: var(--text-sm);
  }

  .cost {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin-top: 1rem;
  }

  .cost div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.2rem;
  }

  .cost dd {
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem);
    font-weight: 600;
    line-height: 1;
    color: var(--text-hi);
    font-variant-numeric: tabular-nums;
  }

  .cost dt {
    font-size: var(--text-xs);
    color: var(--text-low);
  }

  .cost-note {
    font-size: var(--text-xs) !important;
    color: var(--text-low);
    margin-top: 1rem !important;
  }

  .cost-note a {
    color: var(--brand-500);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-left: 0.25rem;
  }

  /* --- What it watches --------------------------------------------------- */
  .section-head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .section-head-row > .section-head {
    margin-bottom: 0;
  }

  .section-head-row .text-link {
    margin-top: 0;
  }

  .watch-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
  }

  .watch-card {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.5rem;
    background: var(--surface-0);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color var(--duration) var(--ease);
  }

  @media (hover: hover) {
    .watch-card:hover {
      border-color: var(--border-strong);
    }
  }

  .watch-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.5rem;
  }

  .watch-card p {
    font-size: var(--text-sm);
  }

  /* --- Live -------------------------------------------------------------- */
  .live-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }

  /* --- How it works ------------------------------------------------------ */
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: 1rem;
  }

  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    background: var(--surface-0);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    min-width: 0;
  }

  .step-wide {
    grid-row: span 2;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--brand-500);
  }

  .step p {
    font-size: var(--text-sm);
  }

  .step pre {
    margin-top: 0.5rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius-md);
    background: var(--surface-inset);
    border: 1px solid var(--border);
    overflow-x: auto;
  }

  .step code {
    display: block;
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--code-text);
    white-space: pre;
  }

  .step-after {
    color: var(--text-hi) !important;
  }

  /* --- Scope and FAQ ----------------------------------------------------- */
  .scope-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }

  .limits,
  .faq {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .limits ul {
    list-style: none;
    display: grid;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .limits li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: var(--text-sm);
    color: var(--text-mid);
    line-height: 1.55;
  }

  .limits :global(.limit-mark) {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--text-low);
  }

  .limits .text-link {
    margin-top: 1rem;
  }

  .faq-list {
    margin-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  details {
    border-bottom: 1px solid var(--border);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.05rem 0.25rem;
    font-weight: 600;
    color: var(--text-hi);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--text-low);
    transition: transform var(--duration-fast) var(--ease);
  }

  details[open] summary::after {
    transform: rotate(45deg);
  }

  details p {
    padding: 0 0.25rem 1.2rem;
    font-size: var(--text-sm);
    max-width: 68ch;
  }

  /* --- Story ------------------------------------------------------------- */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
    gap: 2rem;
    align-items: center;
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius-lg) + 4px);
    background:
      radial-gradient(circle at 100% 0%, color-mix(in oklab, var(--brand-600) 12%, transparent), transparent 55%),
      var(--surface-1);
  }

  .story-copy {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .story-copy p:not(.eyebrow) {
    max-width: 62ch;
  }

  .story-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .story-mark {
    display: grid;
    place-items: center;
    gap: 0.5rem;
  }

  .dash-label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-low);
  }

  .story-mark .dash {
    font-family: var(--font-mono);
    font-size: clamp(6rem, 4rem + 8vw, 11rem);
    line-height: 1;
    color: var(--brand-500);
    opacity: 0.85;
  }

  /* --- Responsive -------------------------------------------------------- */
  @media (max-width: 1024px) {
    .hero-grid,
    .routers-grid,
    .scope-grid {
      grid-template-columns: 1fr;
    }
    .router-visual {
      position: static;
      max-width: 34rem;
    }
    .steps {
      grid-template-columns: 1fr 1fr;
    }
    .step-wide {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  @media (max-width: 760px) {
    .router-items,
    .router-notes,
    .live-grid,
    .steps {
      grid-template-columns: 1fr;
    }
    .story {
      grid-template-columns: 1fr;
    }
