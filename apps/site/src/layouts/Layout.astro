---
import Logo from '../components/Logo.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { GITHUB_REPO_URL } from '../config';
import { alternates, dicts, langFromPath, withSlash } from '../i18n';
import { BUILD } from '../lib/build-info';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Error pages: kept out of the index and without a canonical, because
   *  Pages serves them for every missing path and none of those URLs is theirs. */
  noindex?: boolean;
  /** schema.org objects for this page; rendered as one JSON-LD graph. */
  jsonLd?: Record<string, unknown>[];
}

const SITE = 'https://monitoring.bloodkings.eu';
const currentPath = withSlash(Astro.url.pathname);
const lang = langFromPath(currentPath);
const t = dicts[lang];
const L = t.layout;
const prefix = lang === 'cs' ? '/cs' : '';

const {
  title = L.defaultTitle,
  description = L.defaultDescription,
  ogImage = `${SITE}/og-image.png`,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const alt = alternates(currentPath);
const canonical = new URL(currentPath, SITE).href;
const otherLang = lang === 'cs' ? 'en' : 'cs';

// Internal links end with a slash: the built pages are directories, so a
// slashless link costs a redirect and never matched aria-current.
const nav = [
  { href: `${prefix}/features/`, label: L.features },
  { href: `${prefix}/#routers`, label: L.routers },
  { href: `${prefix}/docs/`, label: L.docs },
  { href: `${prefix}/download/`, label: L.download },
  { href: `${prefix}/changelog/`, label: L.changelog },
  { href: `${prefix}/roadmap/`, label: L.roadmap },
];
const isCurrent = (href: string) => !href.includes('#') && withSlash(href) === currentPath;

const home = `${prefix}/`;
const install = `${prefix}/#install`;
const LIVE_STATUS_URL = 'https://bloodkings.eu/app/public';

// "</script>" inside a string would end the element early.
const graph =
  jsonLd.length === 0
    ? null
    : JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd }).replace(/</g, '\\u003c');

const shortCommit = BUILD.commit?.slice(0, 7) ?? null;
---

<!doctype html>
<html lang={lang} class="dark" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b0d10" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />

    <meta name="robots" content={noindex ? 'noindex' : 'index, follow'} />
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="en" href={new URL(alt.en, SITE).href} />
          <link rel="alternate" hreflang="cs" href={new URL(alt.cs, SITE).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(alt.en, SITE).href} />
        </>
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Blood Kings Monitoring" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={dicts[otherLang].ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <!-- public/og-image.png, rendered from src/assets/og-image.svg. -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={L.ogImageAlt} />

    <!-- X / Twitter cards read name=, not property=. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={L.ogImageAlt} />

    {graph && <script type="application/ld+json" set:html={graph} />}

    <ThemeScript />
  </head>
  <body>
    <a class="skip-link" href="#main">{L.skipToContent}</a>

    <header class="site-header">
      <div class="container header-row">
        <a href={home} class="brand" aria-label="Blood Kings Monitoring">
          <Logo />
          <span class="brand-name">Blood Kings <span class="brand-sub">Monitoring</span></span>
        </a>

        <nav class="desktop-nav" aria-label={L.mainNav}>
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="header-actions">
          <div class="lang-switch" role="group" aria-label={L.language}>
            <a href={alt.en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
            <a href={alt.cs} hreflang="cs" lang="cs" aria-current={lang === 'cs' ? 'true' : undefined}>CS</a>
          </div>

          <button
            type="button"
            class="icon-btn theme-btn"
            id="theme-toggle"
            aria-label={L.themeDark}
            data-label-dark={L.themeDark}
            data-label-light={L.themeLight}
            data-label-auto={L.themeSystem}
          >
            <svg class="i-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
            <svg class="i-light" viewBox="0 0 24 24" aria-hidden="true"
              ><circle cx="12" cy="12" r="4"></circle><path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
              ></path></svg
            >
            <svg class="i-auto" viewBox="0 0 24 24" aria-hidden="true"
              ><rect width="20" height="14" x="2" y="3" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg
            >
          </button>

          <a href={GITHUB_REPO_URL} class="icon-btn gh-link" rel="noopener" aria-label="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="filled"
              ><path
                d="M12 2C6.48 2 2 6.48 2 12.02c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.56 9.56 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.94.36.31.68.92.68 1.86v2.75c0 .27.18.58.69.48A10.02 10.02 0 0 0 22 12.02C22 6.48 17.52 2 12 2z"
              ></path></svg
            >
          </a>

          <a href={install} class="btn btn-primary btn-sm header-cta">{L.install}</a>

          <button
            type="button"
            class="icon-btn menu-btn"
            id="menu-toggle"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label={L.menu}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          </button>
        </div>
      </div>

      <div class="mobile-menu" id="mobile-menu" hidden>
        <nav class="container mobile-nav" aria-label={L.mainNav}>
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href={LIVE_STATUS_URL} rel="noopener">{L.liveStatus}</a>
          <a href={install} class="btn btn-primary">{L.install}</a>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a href={home} class="brand" aria-label="Blood Kings Monitoring">
            <Logo />
            <span class="brand-name">Blood Kings <span class="brand-sub">Monitoring</span></span>
          </a>
          <p>{L.footerDesc}</p>
        </div>
        <nav class="footer-cols" aria-label={L.footerNav}>
          <div>
            <h2>{L.product}</h2>
            <a href={`${prefix}/features/`}>{L.features}</a>
            <a href={`${prefix}/#routers`}>{L.routers}</a>
            <a href={`${prefix}/download/`}>{L.download}</a>
            <a href={`${prefix}/roadmap/`}>{L.roadmap}</a>
          </div>
          <div>
            <h2>{L.resources}</h2>
            <a href={`${prefix}/docs/`}>{L.docs}</a>
            <a href={`${prefix}/changelog/`}>{L.changelog}</a>
            <a href={GITHUB_REPO_URL} rel="noopener">GitHub</a>
            <a href="/.well-known/security.txt">security.txt</a>
          </div>
          <div>
            <h2>{L.project}</h2>
            <a href={`${prefix}/about/`}>{L.about}</a>
            <a href={LIVE_STATUS_URL} rel="noopener">{L.liveStatus}</a>
          </div>
        </nav>
      </div>

      <div class="container">
        <div class="footer-bottom">
          <p>
            &copy; {new Date().getFullYear()} Blood Kings{' · '}
            <a href={`${GITHUB_REPO_URL}/blob/main/LICENSE`} rel="noopener">{L.licence}</a>{' · '}
            {L.noThirdParty}
          </p>
          <p class="mono">
            {
              shortCommit ? (
                <a href={`${GITHUB_REPO_URL}/commit/${BUILD.commit}`} rel="noopener">
                  {L.build} {shortCommit}
                </a>
              ) : (
                <span>{L.build} —</span>
              )
            }
            {' · '}
            <time datetime={BUILD.date}>{BUILD.date}</time>
            {' · '}
            <a href={alt.en} hreflang="en" lang="en">English</a>
            {' · '}
            <a href={alt.cs} hreflang="cs" lang="cs">Čeština</a>
          </p>
        </div>
      </div>
    </footer>

    <script>
      // Theme: dark -> light -> system -> dark. The choice is stored when the
      // storage allows it; a blocked storage only means it is not remembered.
      const root = document.documentElement;
      const button = document.getElementById('theme-toggle');
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      const ORDER = ['dark', 'light', 'auto'] as const;
      type Theme = (typeof ORDER)[number];

      const current = (): Theme => {
        const v = root.dataset.theme;
        return v === 'light' || v === 'auto' ? v : 'dark';
      };

      const sync = () => {
        const theme = current();
        if (button) button.setAttribute('aria-label', button.dataset[`label${theme[0].toUpperCase()}${theme.slice(1)}`] ?? '');
        if (themeColor) themeColor.content = root.classList.contains('dark') ? '#0b0d10' : '#ffffff';
      };

      button?.addEventListener('click', () => {
        const next = ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length];
        const dark = next === 'dark' || (next === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        root.classList.toggle('dark', dark);
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          // Private mode or blocked storage: the theme still changes for this page.
        }
        sync();
      });
      sync();

      // Mobile menu.
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      if (toggle && menu) {
        const setOpen = (open: boolean) => {
          menu.hidden = !open;
          toggle.setAttribute('aria-expanded', String(open));
        };
        toggle.addEventListener('click', () => setOpen(menu.hidden));
        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !menu.hidden) {
            setOpen(false);
            toggle.focus();
          }
        });
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in oklab, var(--surface-0) 84%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .header-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    color: var(--text-hi);
    flex-shrink: 0;
  }

  .brand-sub {
    font-weight: 400;
    color: var(--text-mid);
  }

  .desktop-nav {
    display: flex;
    gap: 0.25rem;
    margin-inline: auto;
  }

  .desktop-nav a {
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-mid);
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'] {
    color: var(--text-hi);
    background: var(--surface-2);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .desktop-nav + .header-actions {
    margin-left: 0;
  }

  .lang-switch {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .lang-switch a {
    min-width: 2.25rem;
    min-height: 1.9rem;
    display: inline-grid;
    place-items: center;
    border-radius: var(--radius-full);
    color: var(--text-mid);
  }

  .lang-switch a:hover {
    color: var(--text-hi);
  }

  .lang-switch a[aria-current='true'] {
    background: var(--surface-2);
    color: var(--text-hi);
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-mid);
    cursor: pointer;
  }

  .icon-btn:hover {
    color: var(--text-hi);
    background: var(--surface-2);
  }

  .icon-btn svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-btn svg.filled {
    fill: currentColor;
    stroke: none;
  }

  .theme-btn svg {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-btn .i-dark,
  :global(:root[data-theme='light']) .theme-btn .i-light,
  :global(:root[data-theme='auto']) .theme-btn .i-auto {
    display: block;
  }

  .menu-btn {
    display: none;
  }

  .mobile-menu {
    border-top: 1px solid var(--border);
    background: var(--surface-0);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 1rem 1.25rem;
  }

  .mobile-nav a:not(.btn) {
    padding: 0.75rem 0.5rem;
    border-radius: var(--radius-sm);
    font-weight: 500;
    color: var(--text-mid);
  }

  .mobile-nav a[aria-current='page'] {
    color: var(--text-hi);
    background: var(--surface-2);
  }

  .mobile-nav .btn {
    margin-top: 0.75rem;
  }

  main {
    flex: 1;
  }

  main:focus {
    outline: none;
  }

  /* --- Footer --------------------------------------------------------- */
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    background: var(--surface-1);
    padding-block: 3.5rem 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 2fr);
    gap: 2.5rem;
  }

  .footer-brand p {
    margin-top: 1rem;
    max-width: 38ch;
    font-size: var(--text-sm);
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .footer-cols div {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-cols h2 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-low);
    margin-bottom: 0.25rem;
  }

  .footer-cols a {
    font-size: var(--text-sm);
    color: var(--text-mid);
    width: fit-content;
  }

  .footer-cols a:hover,
  .footer-bottom a:hover {
    color: var(--text-hi);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .footer-bottom p {
    font-size: var(--text-xs);
    color: var(--text-low);
  }

  .footer-bottom a {
    color: var(--text-mid);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
  }

  .mono {
    font-family: var(--font-mono);
  }

  @media (max-width: 1100px) {
    .desktop-nav {
      display: none;
    }
    .menu-btn {
      display: inline-grid;
    }
  }

  @media (max-width: 560px) {
    .header-row {
      gap: 0.5rem;
    }
    .header-cta,
    .gh-link,
    .brand-sub {
      display: none;
    }
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .footer-cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
